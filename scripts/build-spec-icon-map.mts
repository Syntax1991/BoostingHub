/**
 * One-shot: pull Blizzard playable-specialization media for every catalogued
 * spec id and emit a static TypeScript map (no runtime Blizzard calls).
 *
 * Usage: npx tsx --env-file=.env scripts/build-spec-icon-map.mts
 */
import { writeFileSync } from "node:fs";
import { resolve } from "node:path";
import {
  blizzardApiHost,
  blizzardLocale,
  blizzardStaticNamespace,
  getBlizzardConfig,
  isBlizzardConfigured,
} from "../src/lib/blizzard/config";
import { knownSpecializationIds } from "../src/lib/wow-specializations";

if (!isBlizzardConfigured()) {
  console.error("Blizzard not configured");
  process.exit(1);
}

const c = getBlizzardConfig();
const basic = Buffer.from(`${c.clientId}:${c.clientSecret}`).toString("base64");
const tok = (await (
  await fetch("https://oauth.battle.net/token", {
    method: "POST",
    headers: {
      Authorization: `Basic ${basic}`,
      "Content-Type": "application/x-www-form-urlencoded",
    },
    body: "grant_type=client_credentials",
  })
).json()) as { access_token: string };

const host = blizzardApiHost("EU");
const ns = blizzardStaticNamespace("EU");
const locale = blizzardLocale("EU");
const ids = knownSpecializationIds().sort((a, b) => a - b);
const fileDataIds: Record<number, number> = {};

for (const id of ids) {
  const r = await fetch(
    `${host}/data/wow/media/playable-specialization/${id}?namespace=${ns}&locale=${locale}`,
    { headers: { Authorization: `Bearer ${tok.access_token}` } },
  );
  const j = (await r.json()) as {
    assets?: Array<{ key: string; value: string; file_data_id?: number }>;
  };
  const asset = j.assets?.find((a) => a.key === "icon");
  if (!asset) {
    console.warn("missing", id, r.status);
    continue;
  }
  const match = asset.value.match(/\/(\d+)\.jpg(?:\?|$)/i);
  const fileId = asset.file_data_id ?? (match ? Number(match[1]) : null);
  if (fileId == null) {
    console.warn("no file id", id, asset.value);
    continue;
  }
  fileDataIds[id] = fileId;
  console.log(id, "→", fileId);
}

const out = resolve("src/lib/wow-spec-icon-file-ids.ts");
const body = `/**
 * Blizzard Game Data playable-specialization media file_data_id values.
 * Generated from static-eu media endpoints — do not invent IDs.
 * Runtime renders via render.worldofwarcraft.com (no live API per tile).
 *
 * Regenerated by: npx tsx --env-file=.env scripts/build-spec-icon-map.mts
 */
export const WOW_SPEC_ICON_FILE_DATA_IDS: Readonly<Record<number, number>> = ${JSON.stringify(
  fileDataIds,
  null,
  2,
)} as const;
`;
writeFileSync(out, body);
console.log("wrote", out, Object.keys(fileDataIds).length, "entries");
