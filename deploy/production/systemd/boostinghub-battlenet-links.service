# One-shot "Link Battle.net matches" pass, started by boostinghub-battlenet-links.timer.
#
# Reference copy (docs/deployment-production.md). Install manually on the host as root:
#   install -o root -g root -m 0644 deploy/production/systemd/boostinghub-battlenet-links.service deploy/production/systemd/boostinghub-battlenet-links.timer /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now boostinghub-battlenet-links.timer
#
# Manual run: systemctl start boostinghub-battlenet-links.service

[Unit]
Description=BoostingHub one-shot Battle.net link reconciliation
After=network-online.target postgresql.service boostinghub-web.service

[Service]
Type=oneshot
User=boostinghub
WorkingDirectory=/var/www/boostinghub
Environment=NODE_ENV=production
EnvironmentFile=/var/www/boostinghub/.env
ExecStart=/usr/bin/npm run reconcile:battlenet-links
Nice=10
