# Daily PostgreSQL backup for BoostingHub production.
#
# Install (as root):
#   cp deploy/production/systemd/boostinghub-backup.* /etc/systemd/system/
#   systemctl daemon-reload
#   systemctl enable --now boostinghub-backup.timer

[Unit]
Description=BoostingHub PostgreSQL daily backup
After=postgresql.service

[Service]
Type=oneshot
User=root
ExecStart=/var/www/boostinghub/deploy/production/backup-db.sh
Nice=10
