# Copy to `.env`. Never commit real secrets.

# PostgreSQL 15+ connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/boostting_bot?sslmode=require"

# Dedicated database for automated tests (npm test / npx vitest run) — MUST be
# a separate database from DATABASE_URL, never your real dev/QA database.
# pg-pool.ts (the single place every repository/service connects through)
# refuses to start under Vitest if this is unset or identical to DATABASE_URL,
# so a misconfigured test run fails loudly instead of touching real data.
# `npm run test:db:reset` resets and reseeds THIS database destructively —
# that is safe only because it is not the one above.
#
# One-time setup: create the database on your local Postgres server, e.g.:
#   psql -U postgres -h localhost -c "CREATE DATABASE boostting_bot_test;"
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/boostting_bot_test?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-32-character-or-longer-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Discord OAuth. Leave empty to hide Discord login until credentials exist.
# Redirect URL: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Public Discord channel/ticket URL for booster applications (optional).
# Shown as a CTA when self-service BoosterAccess requests are disabled.
DISCORD_BOOSTER_TICKET_URL=""

# Development-only identity picker. Ignored when NODE_ENV=production.
DEV_AUTH_ENABLED="true"
DEV_AUTH_PASSWORD="dev-login-only"

# Battle.net / Blizzard OAuth. Discord remains login.
# Required for Add Character (Class/Item Level lookup has no manual fallback).
# Battle.net account linking/import stays separately optional on top of this.
# Redirect URL must match the develop.battle.net client exactly.
# Redirect URL: http://localhost:3000/api/integrations/battlenet/callback
BLIZZARD_CLIENT_ID=""
BLIZZARD_CLIENT_SECRET=""
BLIZZARD_REDIRECT_URI="http://localhost:3000/api/integrations/battlenet/callback"

# Discord Bot API — service-to-service auth for the separate bot process.
# High-entropy shared secret, environment only. Never use a session cookie
# or ADMIN account for this. Required by both the Next app (to verify
# incoming bot requests) and the bot process (to authenticate outgoing ones).
BOOSTINGHUB_BOT_API_TOKEN=""

# Discord Bot process (src/discord-bot). Runs as its own long-lived Node
# process — see docs/features/discord-bot.md. Not needed by the Next app.
DISCORD_BOT_TOKEN=""
DISCORD_APPLICATION_ID=""
DISCORD_GUILD_ID=""

# Preferred: the ONE parent category new per-Run text channels are created
# under (e.g. "Weekly Raid Schedule"). Requires the bot to have Manage
# Channels. Leave empty to use the legacy single global channel pair below
# instead. CURRENT and NEXT raid-ID weeks (Wednesday 06:00 Europe/Berlin
# boundary) share this SAME category — Discord channels cannot contain child
# channels, so the two weeks are visually separated by channel ordering
# around the two marker channels below, not by separate categories. See
# docs/features/discord-bot.md § weekly raid-ID sections.
DISCORD_RUN_CATEGORY_ID=""

# The two manually-managed marker text channels inside DISCORD_RUN_CATEGORY_ID
# (e.g. "#current-id" and "#next-id") that anchor the CURRENT/NEXT sections.
# BoostingHub only ever reads their live position — it never creates, renames,
# deletes, or repositions them itself. Required for CURRENT/NEXT ordering;
# when unset, channels still get the correct category and name, just not
# corrected ordering (a warning is logged each poll).
DISCORD_RUN_CURRENT_MARKER_CHANNEL_ID=""
DISCORD_RUN_NEXT_MARKER_CHANNEL_ID=""

# Where an ARCHIVE-targeted Run's channel moves to (e.g. "Weekly Raid Schedule
# Archive") — a real, separate category, unlike CURRENT/NEXT. Covers
# app-archived Runs, and PAST/FUTURE Runs held outside the active rotation.
# Optional — such a channel simply stays put if unset.
DISCORD_RUN_ARCHIVE_CATEGORY_ID=""

# Legacy/test fallback, used only when DISCORD_RUN_CATEGORY_ID is unset.
# At least one of DISCORD_RUN_CATEGORY_ID or DISCORD_SIGNUP_CHANNEL_ID is required.
DISCORD_SIGNUP_CHANNEL_ID=""
DISCORD_ROSTER_CHANNEL_ID=""
# Base URL of the running BoostingHub app, reachable from the bot host.
BOOSTINGHUB_API_BASE_URL="http://localhost:3000"

# Scheduled Blizzard character sync (npm run sync:characters). One-shot job,
# run every ~15 minutes by an EXTERNAL scheduler (cron / Windows Task
# Scheduler) — the app itself never owns this timer. Characters older than
# this are eligible for automatic Blizzard refresh. Must be a positive
# integer; unset falls back to 15. See docs/features/scheduled-character-sync.md.
BLIZZARD_SYNC_STALE_MINUTES="15"
