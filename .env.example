# Copy to `.env`. Never commit real secrets.

# PostgreSQL 15+ connection string.
DATABASE_URL="postgresql://user:password@localhost:5432/boostting_bot?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET="generate-a-32-character-or-longer-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Discord OAuth. Leave empty to hide Discord login until credentials exist.
# Redirect URL: http://localhost:3000/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Public Discord channel/ticket URL for booster applications (optional).
# Shown as a CTA when self-service BoosterAccess requests are disabled.
DISCORD_BOOSTER_TICKET_URL=""

# Development-only identity picker. Ignored when NODE_ENV=production.
DEV_AUTH_ENABLED="true"
DEV_AUTH_PASSWORD="dev-login-only"

# Battle.net / Blizzard OAuth (optional Character integration; Discord remains login).
# Redirect URL must match the develop.battle.net client exactly.
# Redirect URL: http://localhost:3000/api/integrations/battlenet/callback
BLIZZARD_CLIENT_ID=""
BLIZZARD_CLIENT_SECRET=""
BLIZZARD_REDIRECT_URI="http://localhost:3000/api/integrations/battlenet/callback"
