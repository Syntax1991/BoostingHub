{
  "name": "boostting-bot",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db:reset": "tsx scripts/test-db-reset.ts",
    "test:full": "npm run test:db:reset && npm test",
    "db:emit": "prisma contract emit",
    "db:migrate": "prisma db migrate --yes",
    "db:seed": "tsx src/prisma/seed.ts",
    "db:verify": "prisma db verify",
    "contract:emit": "prisma contract emit",
    "bot:dev": "tsx watch src/discord-bot/index.ts",
    "bot:start": "tsx src/discord-bot/index.ts",
    "bot:register-commands": "tsx src/discord-bot/register-commands.ts"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "better-auth": "^1.7.3",
    "clsx": "^2.1.1",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^8.0.0-rc.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
