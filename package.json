{
  "name": "boostting-bot",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "tsx scripts/check-dev-db-schema.ts",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db:reset": "tsx scripts/test-db-reset.ts",
    "test:full": "npm run test:db:reset && npm test",
    "db:emit": "prisma contract emit",
    "db:migrate": "prisma db migrate --yes",
    "db:seed": "tsx src/prisma/seed.ts",
    "owner:bootstrap": "tsx scripts/owner-bootstrap.mts",
    "db:verify": "prisma db verify",
    "db:status": "prisma migration status",
    "bot:dev": "tsx watch src/discord-bot/index.ts",
    "bot:start": "tsx src/discord-bot/index.ts",
    "bot:register-commands": "tsx src/discord-bot/register-commands.ts",
    "sync:characters": "tsx scripts/sync-blizzard-characters.ts",
    "materialize:community-schedule": "tsx scripts/materialize-community-schedule.ts",
    "reconcile:battlenet-links": "tsx scripts/reconcile-battlenet-links.ts",
    "guide:screenshots": "tsx scripts/capture-guide-screenshots.mts",
    "guide:booster:preview": "tsx --env-file=.env scripts/publish-guide.mts --guide=booster",
    "guide:booster:publish": "tsx --env-file=.env scripts/publish-guide.mts --guide=booster --publish",
    "guide:booster:replace:plan": "tsx --env-file=.env scripts/publish-guide.mts --guide=booster --replace",
    "guide:booster:replace:publish": "tsx --env-file=.env scripts/publish-guide.mts --guide=booster --replace --publish",
    "guide:booster:replace:retire": "tsx --env-file=.env scripts/publish-guide.mts --guide=booster --replace --retire-old",
    "guide:raidlead:preview": "tsx --env-file=.env scripts/publish-guide.mts --guide=raidlead",
    "guide:raidlead:publish": "tsx --env-file=.env scripts/publish-guide.mts --guide=raidlead --publish",
    "guide:raidlead:replace:plan": "tsx --env-file=.env scripts/publish-guide.mts --guide=raidlead --replace",
    "guide:raidlead:replace:publish": "tsx --env-file=.env scripts/publish-guide.mts --guide=raidlead --replace --publish",
    "guide:raidlead:replace:retire": "tsx --env-file=.env scripts/publish-guide.mts --guide=raidlead --replace --retire-old",
    "guide:raidlead:screenshots": "tsx scripts/capture-raidlead-guide-screenshots.mts"
  },
  "dependencies": {
    "@prisma/orm-postgres": "^8.0.0-rc.8",
    "better-auth": "^1.7.15",
    "clsx": "^2.1.1",
    "discord.js": "^14.28.0",
    "dotenv": "^17.4.2",
    "lucide-react": "^1.43.0",
    "next": "16.4.3",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@prisma/cli-engine": "^0.2.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.55.0",
    "prettier": "^3.9.6",
    "prisma": "^8.0.0-rc.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
