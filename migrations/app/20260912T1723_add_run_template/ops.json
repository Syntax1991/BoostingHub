        "description": "create table \"run_template\"",
        "sql": "CREATE TABLE \"public\".\"run_template\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdById\" text NOT NULL,\n  \"desiredDpsCount\" int4 NOT NULL,\n  \"desiredHealerCount\" int4 NOT NULL,\n  \"desiredTankCount\" int4 NOT NULL,\n  \"difficulty\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"isActive\" bool DEFAULT true NOT NULL,\n  \"lootType\" text NOT NULL,\n  \"name\" text NOT NULL,\n  \"notes\" text,\n  \"plannedBossCount\" int4 NOT NULL,\n  \"raidId\" text NOT NULL,\n  \"raidLeadId\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"updatedById\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"run_template_difficulty_check_05ae26c2\" CHECK (\"difficulty\" IN ('NORMAL', 'HEROIC', 'MYTHIC')),\n  CONSTRAINT \"run_template_lootType_check_3071d052\" CHECK (\"lootType\" IN ('SAVED', 'UNSAVED', 'VIP'))\n)",
        "params": []
      }
    ],
