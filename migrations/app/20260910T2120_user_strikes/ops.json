        "description": "create table \"strike\"",
        "sql": "CREATE TABLE \"public\".\"strike\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"createdById\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"notes\" text,\n  \"reason\" text NOT NULL,\n  \"revokedAt\" timestamptz,\n  \"revokedById\" text,\n  \"revokedReason\" text,\n  \"runId\" text,\n  \"status\" text DEFAULT 'ACTIVE' NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"userId\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"strike_status_check_35f03e2c\" CHECK (\"status\" IN ('ACTIVE', 'REVOKED'))\n)",
        "params": []
