        "description": "create table \"run_discord_announcement\"",
        "sql": "CREATE TABLE \"public\".\"run_discord_announcement\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"difficulty\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"lootType\" text NOT NULL,\n  \"previousScheduledStartAt\" timestamptz,\n  \"productLabel\" text NOT NULL,\n  \"runId\" text NOT NULL,\n  \"scheduledStartAt\" timestamptz NOT NULL,\n  \"sentAt\" timestamptz,\n  \"sourceKey\" text NOT NULL,\n  \"status\" text NOT NULL,\n  \"type\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"run_discord_announcement_difficulty_check_05ae26c2\" CHECK (\"difficulty\" IN ('NORMAL', 'HEROIC', 'MYTHIC')),\n  CONSTRAINT \"run_discord_announcement_lootType_check_3071d052\" CHECK (\"lootType\" IN ('SAVED', 'UNSAVED', 'VIP')),\n  CONSTRAINT \"run_discord_announcement_status_check_86966e08\" CHECK (\"status\" IN ('PENDING', 'SENT', 'SKIPPED', 'FAILED_PERMANENT')),\n  CONSTRAINT \"run_discord_announcement_type_check_b8186a62\" CHECK (\"type\" IN ('RUN_RESCHEDULED', 'RUN_CANCELLED'))\n)",
        "params": []
      }
