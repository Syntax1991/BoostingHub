    "execute": [
      {
        "description": "create table \"user_notification\"",
        "sql": "CREATE TABLE \"public\".\"user_notification\" (\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"discordDeliveryStatus\" text NOT NULL,\n  \"discordUserId\" text,\n  \"href\" text NOT NULL,\n  \"id\" text NOT NULL,\n  \"message\" text NOT NULL,\n  \"readAt\" timestamptz,\n  \"runId\" text,\n  \"signupId\" text,\n  \"sourceKey\" text NOT NULL,\n  \"title\" text NOT NULL,\n  \"type\" text NOT NULL,\n  \"updatedAt\" timestamptz NOT NULL,\n  \"userId\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"user_notification_discordDeliveryStatus_check_2752241d\" CHECK (\"discordDeliveryStatus\" IN ('PENDING', 'SENT', 'SKIPPED', 'FAILED_PERMANENT')),\n  CONSTRAINT \"user_notification_type_check_1b0a5b12\" CHECK (\"type\" IN ('ROSTER_SELECTED', 'RAID_INVITE'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"user_notification\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"user_notification\""
        ]
