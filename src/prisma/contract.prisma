// Boostting Bot domain contract.
// Prisma 8 stores enums as text columns with CHECK constraints, not native PG enums.

/// Hierarchical platform permissions: OWNER > ADMIN > RAID_LEAD > USER.
/// OWNER is the protected platform owner (at most one — see User's partial
/// unique index); it is only ever set by the explicit owner bootstrap, never
/// by generic role management.
enum AccountRole {
  @@type("pg/text@1")
  USER      = "USER"
  RAID_LEAD = "RAID_LEAD"
  ADMIN     = "ADMIN"
  OWNER     = "OWNER"
}

/// Safe, fixed category of the latest failed Blizzard sync attempt for a
/// Character. Never a raw upstream message. Eligibility failures (not linked,
/// no Battle.net connection) are not attempts and are never stored here.
enum CharacterSyncErrorCode {
  @@type("pg/text@1")
  PROFILE_UNAVAILABLE  = "PROFILE_UNAVAILABLE"
  IDENTITY_CONFLICT    = "IDENTITY_CONFLICT"
  NAME_CONFLICT        = "NAME_CONFLICT"
  RATE_LIMITED         = "RATE_LIMITED"
  UPSTREAM_UNAVAILABLE = "UPSTREAM_UNAVAILABLE"
  AUTH_OR_CONFIG       = "AUTH_OR_CONFIG"
  INTERNAL             = "INTERNAL"
}

enum AccountStatus {
  @@type("pg/text@1")
  ACTIVE   = "ACTIVE"
  DISABLED = "DISABLED"
}

enum WowClass {
  @@type("pg/text@1")
  DEATH_KNIGHT = "DEATH_KNIGHT"
  DEMON_HUNTER = "DEMON_HUNTER"
  DRUID        = "DRUID"
  EVOKER       = "EVOKER"
  HUNTER       = "HUNTER"
  MAGE         = "MAGE"
  MONK         = "MONK"
  PALADIN      = "PALADIN"
  PRIEST       = "PRIEST"
  ROGUE        = "ROGUE"
  SHAMAN       = "SHAMAN"
  WARLOCK      = "WARLOCK"
  WARRIOR      = "WARRIOR"
}

enum CharacterRole {
  @@type("pg/text@1")
  TANK       = "TANK"
  HEALER     = "HEALER"
  MELEE_DPS  = "MELEE_DPS"
  RANGED_DPS = "RANGED_DPS"
  /// Legacy generic DPS — readable on historic rows; never invent a subtype.
  DPS        = "DPS"
}

enum WowRegion {
  @@type("pg/text@1")
  EU = "EU"
  US = "US"
}

enum RaidDifficulty {
  @@type("pg/text@1")
  NORMAL = "NORMAL"
  HEROIC = "HEROIC"
  MYTHIC = "MYTHIC"
}

/// Independent of RaidDifficulty. Compatibility (e.g. MYTHIC cannot be SAVED)
/// is a domain rule enforced in the Service layer, not a schema constraint.
/// Persisted column remains `lootType`; product UI presents these as Run types.
enum RunLootType {
  @@type("pg/text@1")
  SAVED      = "SAVED"
  UNSAVED    = "UNSAVED"
  VIP        = "VIP"
  COMMUNITY  = "COMMUNITY"
}

enum BoosterAccessStatus {
  @@type("pg/text@1")
  PENDING  = "PENDING"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
  REVOKED  = "REVOKED"
}

enum RunStatus {
  @@type("pg/text@1")
  DRAFT       = "DRAFT"
  OPEN        = "OPEN"
  ROSTERING   = "ROSTERING"
  PUBLISHED   = "PUBLISHED"
  IN_PROGRESS = "IN_PROGRESS"
  COMPLETED   = "COMPLETED"
  CANCELLED   = "CANCELLED"
}

enum SignupStatus {
  @@type("pg/text@1")
  PENDING      = "PENDING"
  SELECTED     = "SELECTED"
  NOT_SELECTED = "NOT_SELECTED"
  WITHDRAWN    = "WITHDRAWN"
}

enum ParticipationType {
  @@type("pg/text@1")
  BOOSTER   = "BOOSTER"
  LOOTBUDDY = "LOOTBUDDY"
}

enum LootbuddyMode {
  @@type("pg/text@1")
  LOOT_ONLY = "LOOT_ONLY"
  PLAYING   = "PLAYING"
}

enum LootbuddyVerification {
  @@type("pg/text@1")
  NONE   = "NONE"
  ACCESS = "ACCESS"
  TRIAL  = "TRIAL"
}

/// Draft until the first successful publish; stays PUBLISHED while a replacement draft is edited.
enum RosterState {
  @@type("pg/text@1")
  DRAFT     = "DRAFT"
  PUBLISHED = "PUBLISHED"
}

/// Operational attendance for one published selected roster participant.
enum AttendanceStatus {
  @@type("pg/text@1")
  UNMARKED    = "UNMARKED"
  PRESENT     = "PRESENT"
  LATE        = "LATE"
  LEFT_EARLY  = "LEFT_EARLY"
  NO_SHOW     = "NO_SHOW"
  EXCUSED     = "EXCUSED"
  STANDBY     = "STANDBY"
}

/// Bookkeeping lifecycle for one completed-run gold settlement. Not a wallet.
enum SettlementStatus {
  @@type("pg/text@1")
  DRAFT     = "DRAFT"
  FINALIZED = "FINALIZED"
  PAID      = "PAID"
}

/// Settlement-time Raid Lead payout mode for the 3% Raid Lead cut.
/// KEEP: Raid Lead keeps 3% separately. SHARE: 3% joins the Booster Pool.
enum RaidLeadCutMode {
  @@type("pg/text@1")
  KEEP  = "KEEP"
  SHARE = "SHARE"
}

/// No hard delete. REVOKED is a staff correction, not an expiry — there is no
/// automatic expiry status in this contract.
enum StrikeStatus {
  @@type("pg/text@1")
  ACTIVE  = "ACTIVE"
  REVOKED = "REVOKED"
}

/// In-app / Discord DM notification kinds for this phase.
enum NotificationType {
  @@type("pg/text@1")
  ROSTER_SELECTED  = "ROSTER_SELECTED"
  RAID_INVITE      = "RAID_INVITE"
  RUN_CANCELLED    = "RUN_CANCELLED"
  RUN_RESCHEDULED  = "RUN_RESCHEDULED"
  ROSTER_REMOVED   = "ROSTER_REMOVED"
  /// To the Run's Raid Lead: a picked player withdrew (with their reason).
  ROSTER_WITHDRAWN = "ROSTER_WITHDRAWN"
  /// Correction after Reactivate Run — same audience as RUN_CANCELLED.
  RUN_REACTIVATED  = "RUN_REACTIVATED"
}

/// Discord DM delivery decision snapshotted at notification creation.
enum DiscordDeliveryStatus {
  @@type("pg/text@1")
  PENDING          = "PENDING"
  SENT             = "SENT"
  SKIPPED          = "SKIPPED"
  FAILED_PERMANENT = "FAILED_PERMANENT"
}

/// Shared Run-channel lifecycle posts (orthogonal to per-User DM preferences).
enum RunDiscordAnnouncementType {
  @@type("pg/text@1")
  RUN_RESCHEDULED = "RUN_RESCHEDULED"
  RUN_CANCELLED   = "RUN_CANCELLED"
  RUN_REACTIVATED = "RUN_REACTIVATED"
}

/// Application account. Also serves as the Better Auth `user` table.
/// Account roles are permissions on the platform, not run participation type.
model User {
  id              String        @id @default(uuid())
  name            String
  email           String?       @unique
  emailVerified   Boolean       @default(false)
  image           String?
  discordUserId   String?       @unique
  discordUsername String?
  accountStatus   AccountStatus @default(ACTIVE)
  accountRole     AccountRole   @default(USER)
  /// Manual Boosting Role: approved to sign up and be rostered as a Booster.
  /// Account-level, never scoped by RaidDifficulty, independent of accountRole.
  /// Never overwritten by Discord sync — see discordRaidBooster for Discord-derived grant.
  isBooster       Boolean       @default(false)
  /// Manual Boosting Role: recognised Lootbuddy. Independent of isBooster and accountRole.
  /// Management/display only — Lootbuddy signups are not gated by it.
  /// Never overwritten by Discord sync — see discordLootbuddy for Discord-derived grant.
  isLootbuddy     Boolean       @default(false)
  /// Last authoritative Discord guild membership held the Raid Booster role.
  /// Independent of isBooster. Cleared on authoritative role absence, guild departure, or unlink.
  discordRaidBooster Boolean @default(false)
  /// Last authoritative Discord guild membership held the Lootbuddy role.
  /// Independent of isLootbuddy. Cleared on authoritative role absence, guild departure, or unlink.
  discordLootbuddy   Boolean @default(false)
  /// Master override for Discord DMs. Does not rewrite per-event toggles.
  discordDmEnabled            Boolean @default(true)
  /// When true, newly published roster picks may request a Discord DM.
  dmRosterSelectedEnabled     Boolean @default(true)
  /// When true, Start Run Raid Invite may request a Discord DM.
  dmRaidInviteEnabled         Boolean @default(true)
  /// When true, Run CANCELLED may request a Discord DM.
  dmRunCancelledEnabled       Boolean @default(true)
  /// When true, scheduledStartAt changes may request a Discord DM.
  dmRunRescheduledEnabled     Boolean @default(true)
  /// When true, published SELECTED → NOT_SELECTED may request a Discord DM.
  dmRosterRemovedEnabled      Boolean @default(true)
  /// IANA timezone for personal presentation (not community/Discord channel authority).
  timeZone                    String  @default("Europe/Berlin")
  /// Preferred Character for signup UX only — never bypasses eligibility.
  defaultCharacterId          String?
  defaultCharacter            Character? @relation("UserDefaultCharacter", fields: [defaultCharacterId], references: [id], onDelete: SetNull)
  /// Optional short name for Discord Run channel Raid Lead segment only.
  /// Null falls back to User.name. Does not affect Run.title or web identity.
  discordRunChannelNickname   String?
  /// When true, optional personal Discord DMs are deferred during Quiet Hours.
  /// Does not affect in-app notifications or shared Run-channel messages.
  discordDmQuietHoursEnabled  Boolean @default(false)
  /// Local wall-clock HH:MM Quiet Hours start (inclusive), interpreted in timeZone.
  discordDmQuietHoursStart    String?
  /// Local wall-clock HH:MM Quiet Hours end (exclusive), interpreted in timeZone.
  discordDmQuietHoursEnd      String?
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  sessions      Session[]
  accounts      Account[]
  characters     Character[]
  boosterAccess  BoosterAccess[] @relation("UserBoosterAccess")
  ledRuns        Run[]           @relation("RunRaidLead")
  signups        RunSignup[]
  createdRunTemplates  RunTemplate[] @relation("RunTemplateCreator")
  updatedRunTemplates  RunTemplate[] @relation("RunTemplateUpdater")
  communityScheduleSlots          CommunityScheduleSlot[] @relation("CommunityScheduleRaidLead")
  createdCommunityScheduleSlots   CommunityScheduleSlot[] @relation("CommunityScheduleCreator")
  updatedCommunityScheduleSlots   CommunityScheduleSlot[] @relation("CommunityScheduleUpdater")
  createdCommunityScheduleRuns    CommunityScheduleRun[]  @relation("CommunityScheduleRunCreator")
  approvedAccess   BoosterAccess[] @relation("BoosterAccessApprover")
  reviewedAccess   BoosterAccess[] @relation("BoosterAccessReviewer")
  activity         ActivityEvent[]
  publishedRosters RunRoster[]     @relation("RosterPublisher")
  markedAttendance RunAttendance[] @relation("AttendanceMarker")
  preparedSettlements  RunSettlement[] @relation("SettlementPreparer")
  finalizedSettlements RunSettlement[] @relation("SettlementFinalizer")
  paidSettlements      RunSettlement[] @relation("SettlementPayer")
  payoutEntries        RunPayoutEntry[] @relation("PayoutRecipient")
  strikes              Strike[]        @relation("StrikeSubject")
  createdStrikes       Strike[]        @relation("StrikeCreator")
  revokedStrikes       Strike[]        @relation("StrikeRevoker")
  startedRunSnapshots  RunStartSnapshot[] @relation("RunStartStarter")
  battleNetConnections BattleNetConnection[]
  battleNetImportSessions BattleNetImportSession[]
  notifications        UserNotification[]
  analyzedConsumableAudits RunConsumableAudit[] @relation("ConsumableAuditAnalyzer")
  attachedWarcraftLogsReports RunWarcraftLogsReport[] @relation("WarcraftLogsReportAttacher")
  decidedWarcraftLogsFights   RunWarcraftLogsFight[]  @relation("WarcraftLogsFightDecider")
  runDomainEvents          RunDomainEvent[] @relation("RunDomainEventActor")

  /// At most one OWNER, enforced by the database: a partial unique index over
  /// the OWNER rows only, so two concurrent owner bootstraps cannot both commit.
  @@index([accountRole], unique: true, where: "(\"accountRole\" = 'OWNER'::text)", name: "user_single_owner")
  @@map("user")
}

/// Durable per-User notification. Web delivery is always on; Discord DM intent
/// is snapshotted into discordDeliveryStatus at creation (never re-evaluated
/// from live preferences for historical rows).
model UserNotification {
  id                    String                @id @default(uuid())
  userId                String
  user                  User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                  NotificationType
  runId                 String?
  run                   Run?                  @relation(fields: [runId], references: [id], onDelete: SetNull)
  signupId              String?
  signup                RunSignup?            @relation(fields: [signupId], references: [id], onDelete: SetNull)
  /// Deterministic idempotency key, e.g. roster-selected:<runId>:<version>:<signupId>
  sourceKey             String                @unique
  title                 String
  message               String
  href                  String
  readAt                TimestamptzString?
  discordDeliveryStatus DiscordDeliveryStatus
  /// Discord snowflake snapshotted when PENDING was chosen; null when SKIPPED.
  discordUserId         String?
  /// When set, bot delivery lane must wait until this UTC instant (Quiet Hours snapshot).
  /// Null means immediately eligible. Never re-evaluated from live Settings.
  discordDeliverAfter   TimestamptzString?
  /// false = internal notification-state row (e.g. the old character's removal in a
  /// booster character swap). Kept for roster notification state, never shown to the user.
  visibleInApp          Boolean               @default(true)
  createdAt             TimestamptzString     @default(now())
  updatedAt             temporal.updatedAtString()

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([discordDeliveryStatus])
  @@index([discordDeliveryStatus, discordDeliverAfter], map: "user_notification_dm_deliver_idx")
  @@map("user_notification")
}

/// Optional Battle.net link per BoostingHub user + region.
/// Discord remains login. User OAuth tokens are never persisted here.
model BattleNetConnection {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  region             WowRegion
  battleNetAccountId String
  battleTag          String?
  scope              String?
  connectedAt        TimestamptzString
  lastSuccessfulSyncAt TimestamptzString?
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  @@unique([userId, region])
  @@index([userId])
  @@map("battle_net_connection")
}

/// Short-lived authoritative owned-character snapshot after OAuth.
/// Stores no OAuth tokens. Client selects by id against this snapshot only.
model BattleNetImportSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region      WowRegion
  charactersJson String
  expiresAt   TimestamptzString
  consumedAt  TimestamptzString?
  createdAt   TimestamptzString @default(now())

  @@index([userId, region])
  @@index([expiresAt])
  @@map("battle_net_import_session")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt TimestamptzString
  token     String   @unique
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String   @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@map("verification")
}

/// Owned WoW character. Display name/realm stay as entered; normalizedName /
/// normalizedRealm plus region form the owner-scoped unique identity.
/// Class is immutable after create until Blizzard sync can correct it.
/// Deactivate instead of delete so historical signups and lockouts survive.
model Character {
  id                   String        @id @default(uuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  realm                String
  region               WowRegion
  normalizedName       String
  normalizedRealm      String
  wowClass             WowClass
  specialization       String?
  primaryRole          CharacterRole
  /// Blizzard-authoritative equipped item level. Null when Blizzard has not
  /// supplied one yet (never a 0 sentinel; never a manual User override).
  itemLevel            Int?
  isActive             Boolean       @default(true)
  /// Scoped Blizzard identity is region + blizzardRealmId + blizzardCharacterId.
  /// Not a global GUID; may change on realm transfer.
  blizzardCharacterId  String?
  blizzardRealmId      String?
  warcraftLogsId       String?
  /// Last SUCCESSFUL Blizzard profile sync (scheduler freshness is based on this).
  lastSyncedAt         TimestamptzString?
  /// Start of the latest real sync attempt, successful or not (manual cooldown basis).
  lastSyncAttemptAt    TimestamptzString?
  /// Latest failed attempt; cleared on success. ERROR health = newer than lastSyncedAt.
  lastSyncErrorAt      TimestamptzString?
  /// Safe category of the latest failure; cleared on success.
  lastSyncErrorCode    CharacterSyncErrorCode?
  /// Consecutive failed attempts; reset to 0 on success.
  syncFailureCount     Int           @default(0)
  createdAt            TimestamptzString @default(now())
  updatedAt            temporal.updatedAtString()

  lockouts      CharacterRaidLockout[]
  /// DEPRECATED: legacy external-interval blocks. Inert — ignored by scheduling.
  availabilityBlocks CharacterAvailabilityBlock[]
  weeklyUnavailability CharacterWeeklyUnavailability[]
  /// Additional playable specializations (never includes primary `specialization`).
  playableSpecs CharacterPlayableSpec[]
  signups       RunSignup[]
  boosterAccess BoosterAccess[]
  payoutEntries RunPayoutEntry[]
  wclPerformance CharacterWclPerformance[]
  defaultForUsers User[] @relation("UserDefaultCharacter")

  @@unique([userId, region, normalizedRealm, normalizedName])
  /// One scoped Blizzard character may link to at most one BoostingHub row.
  /// Multiple NULLs remain allowed for manual Characters.
  @@unique([region, blizzardRealmId, blizzardCharacterId])
  @@index([userId])
  @@map("character")
}

/// Extra specializations this Character can play beyond primary `specialization`.
/// Specs are authoritative; roster roles are derived via the catalog.
model CharacterPlayableSpec {
  id             String    @id @default(uuid())
  characterId    String
  character      Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  specialization String
  createdAt      TimestamptzString @default(now())

  @@unique([characterId, specialization])
  @@index([characterId])
  @@map("character_playable_spec")
}

/// Cached Warcraft Logs Best/Avg zone (or encounter) percentiles for roster UI.
/// Informational only — never eligibility. `encounterId` 0 = full zone rankings.
model CharacterWclPerformance {
  id            String   @id @default(uuid())
  characterId   String
  character     Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  zoneId        Int
  /// 0 = zone-wide; otherwise WCL encounter id (e.g. Nymrissa).
  encounterId   Int      @default(0)
  /// WCL difficulty filter: 3 Normal, 4 Heroic, 5 Mythic.
  difficulty    Int
  /// Cache key e.g. `dps`, `hps`, `tank-dps`, optionally `dps:Frost`.
  metricKey     String
  bestPct       Float?
  avgPct        Float?
  fetchedAt     TimestamptzString
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@unique([characterId, zoneId, encounterId, difficulty, metricKey], map: "character_wcl_perf_uq")
  @@index([characterId], map: "character_wcl_perf_character_idx")
  @@map("character_wcl_performance")
}

/// DEPRECATED / INERT — former External planning interval blocks.
/// Kept in schema so historical rows are not destructively dropped.
/// Active scheduling uses CharacterWeeklyUnavailability + Run reservations only.
model CharacterAvailabilityBlock {
  id          String             @id @default(uuid())
  characterId String
  character   Character          @relation(fields: [characterId], references: [id], onDelete: Cascade)
  startsAt    TimestamptzString
  endsAt      TimestamptzString
  /// Optional free-text (e.g. "External boost"). Never an enum for v1.
  reason      String?
  createdAt   TimestamptzString  @default(now())
  updatedAt   temporal.updatedAtString()

  @@index([characterId])
  @@map("character_availability_block")
}

/// Owner-marked weekly unavailability for one Character + regional WoW reset + difficulty.
/// Presence = Unavailable for that difficulty during that reset. Absence = Available (default).
/// Does not store reasons or calendar intervals.
model CharacterWeeklyUnavailability {
  id               String            @id @default(uuid())
  characterId      String
  character        Character         @relation(fields: [characterId], references: [id], onDelete: Cascade)
  /// Regional WoW reset identifier (same authority as lockouts).
  resetIdentifier  String
  difficulty       RaidDifficulty
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@unique([characterId, resetIdentifier, difficulty])
  @@index([characterId])
  @@index([resetIdentifier])
  @@map("character_weekly_unavailability")
}

/// LEGACY historical booster application/history.
/// Preserves User + Class + Role + Difficulty (+ optional Character context).
/// NOT the current eligibility source — see User.isBooster. Never read for eligibility.
model BoosterAccess {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation("UserBoosterAccess", fields: [userId], references: [id], onDelete: Cascade)
  characterId  String?
  character    Character?          @relation(fields: [characterId], references: [id], onDelete: SetNull)
  wowClass     WowClass
  role         CharacterRole
  difficulty   RaidDifficulty
  status       BoosterAccessStatus
  approvedAt   TimestamptzString?
  approvedById String?
  approvedBy   User?               @relation("BoosterAccessApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  reviewedAt   TimestamptzString?
  reviewedById String?
  reviewedBy   User?               @relation("BoosterAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([userId, wowClass, role, difficulty])
  @@index([userId])
  @@index([status])
  @@map("booster_access")
}

/// Raid catalog (database authority). Stable UUIDs are historical identity:
/// Runs, templates and lockouts reference them forever.
/// `isActive` is an admin flag ("Available for new Runs") for historical /
/// non-product-matched template usability — Product.active/selectable own
/// new Product planning selection. Never rename to a second ambiguous `active`.
model Raid {
  id        String   @id @default(uuid())
  name      String
  season    String
  isActive  Boolean  @default(true)
  /// Deterministic catalog order (lockout derivation, admin lists).
  sortOrder Int      @default(0)
  /// Blizzard lockout refresh derives this raid (replaces code currentForLockouts).
  trackLockouts Boolean @default(false)
  /// Blizzard journal instance id (Character Raid Encounters `instance.id`).
  blizzardInstanceId Int?
  /// Warcraft Logs zone id for roster Best/Avg percentiles.
  wclZoneId Int?
  /// When set, WCL rankings are scoped to this encounter within `wclZoneId`.
  wclRankingEncounterId Int?
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  bosses   RaidBoss[]
  lockouts CharacterRaidLockout[]
  runContents RunRaidContent[]
  templateContents RunTemplateRaidContent[]
  productContents ProductRaidContent[]

  @@map("raid")
}

model RaidBoss {
  id        String @id @default(uuid())
  raidId    String
  raid      Raid   @relation(fields: [raidId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int
  /// JSON number array: Blizzard journal encounter ids (lockout match key).
  blizzardEncounterIds String @default("[]")
  /// JSON number array: Warcraft Logs encounter ids (`ReportFight.encounterID`).
  wclEncounterIds String @default("[]")

  @@index([raidId])
  @@map("raid_boss")
}

/// How a product content determines its planned boss count.
enum ProductBossCountMode {
  @@type("pg/text@1")
  FIXED = "FIXED"
  VARIABLE = "VARIABLE"
}

/// Sellable BoostingHub product (e.g. a raid or a multi-raid Bundle).
/// Seeded Product catalog fixture identity. Runtime planning reads DB Products.
model Product {
  id         String  @id @default(uuid())
  key        String  @unique
  name       String
  active     Boolean @default(true)
  selectable Boolean @default(true)
  sortOrder  Int     @default(0)
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  contents ProductRaidContent[]

  @@map("product")
}

/// Ordered real raid contents of one Product.
model ProductRaidContent {
  id               String  @id @default(uuid())
  productId        String
  product          Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  raidId           String
  raid             Raid    @relation(fields: [raidId], references: [id], onDelete: Restrict)
  /// 1-based deterministic order within the Product.
  sortOrder        Int
  bossCountMode    ProductBossCountMode
  /// FIXED mode: exact planned boss count.
  fixedBossCount   Int?
  /// VARIABLE mode: lowest selectable boss count.
  minBossCount     Int?
  /// VARIABLE mode: preselected boss count.
  defaultBossCount Int?

  @@unique([productId, sortOrder])
  @@unique([productId, raidId])
  @@index([raidId])
  @@map("product_raid_content")
}

/// Lockouts are scoped to character + raid + difficulty + weekly reset.
/// They are never stored as a boolean on the character itself.
model CharacterRaidLockout {
  id               String         @id @default(uuid())
  characterId      String
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  raidId           String
  raid             Raid           @relation(fields: [raidId], references: [id], onDelete: Cascade)
  difficulty       RaidDifficulty
  resetIdentifier  String
  bossesDefeated   Int            @default(0)
  isComplete       Boolean        @default(false)
  /// JSON array of catalog boss ids (wow-raid-catalog) killed this reset, from
  /// the Blizzard encounters sync. Null for rows synced before this existed.
  killedBossIds    String?
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@unique([characterId, raidId, difficulty, resetIdentifier])
  @@index([characterId])
  @@map("character_raid_lockout")
}

model Run {
  id                 String         @id @default(uuid())
  /// Server-derived (buildRunTitle) from scheduledStartAt/difficulty/lootType/
  /// raid contents/raidLead — never a free-form User-authored value.
  title              String
  /// Authoritative raid identity is ordered RunRaidContent[] only.
  difficulty         RaidDifficulty
  /// Independent of difficulty; MYTHIC+SAVED is rejected at the Service layer.
  lootType           RunLootType
  scheduledStartAt   TimestamptzString
  /// Increments only when scheduledStartAt changes — identity for RUN_RESCHEDULED.
  scheduleRevision   Int            @default(0)
  status             RunStatus
  raidLeadId         String
  raidLead           User           @relation("RunRaidLead", fields: [raidLeadId], references: [id], onDelete: Restrict)
  notes              String?
  desiredTankCount   Int
  desiredHealerCount Int
  desiredDpsCount    Int
  /// Planned Lootbuddy slots — a target only, never a signup or roster entry.
  desiredLootbuddyCount Int @default(0)
  /// When true, first Discord channel provision pings Tank/Healer/DPS roles.
  discordRolePing    Boolean        @default(true)
  signupsOpen        Boolean        @default(false)
  /// Monotonic cancellation-cycle identity. Incremented on each Cancel Run so
  /// RUN_CANCELLED / RUN_REACTIVATED source keys stay distinct across cycles.
  cancelRevision     Int            @default(0)
  /// Snapshot of Run.status immediately before the latest Cancel (null when
  /// not cancelled, or for legacy CANCELLED rows predating this field).
  cancelledFromStatus RunStatus?
  /// Snapshot of signupsOpen immediately before the latest Cancel.
  cancelledFromSignupsOpen Boolean?
  /// Set when the Run transitions IN_PROGRESS → COMPLETED. Null for Runs
  /// completed before this existed (their end time is unknown).
  completedAt        TimestamptzString?
  archivedAt         TimestamptzString?
  archivedById       String?
  archivedBy         User?          @relation("RunArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  contents      RunRaidContent[]
  signups       RunSignup[]
  roster        RunRoster?
  attendance    RunAttendance[]
  startSnapshot RunStartSnapshot?
  settlement    RunSettlement?
  strikes       Strike[]
  discordPost   RunDiscordPost?
  notifications UserNotification[]
  discordAnnouncements RunDiscordAnnouncement[]
  consumableAudit RunConsumableAudit?
  warcraftLogsReports RunWarcraftLogsReport[]
  warcraftLogsFights  RunWarcraftLogsFight[]
  domainEvents        RunDomainEvent[]
  /// At most one Community Schedule materialization link per Run.
  communityScheduleRun CommunityScheduleRun?

  @@index([scheduledStartAt])
  @@index([status])
  @@index([archivedAt])
  @@map("run")
}

/// Ordered real raid instances that belong to one BoostingHub Run.
/// A Bundle is one Run with multiple contents — never a fake aggregated raid.
model RunRaidContent {
  id               String @id @default(uuid())
  runId            String
  run              Run    @relation(fields: [runId], references: [id], onDelete: Cascade)
  raidId           String
  raid             Raid   @relation(fields: [raidId], references: [id], onDelete: Restrict)
  /// 1-based deterministic order within the Run.
  sortOrder        Int
  /// 1 <= plannedBossCount <= this content Raid's RaidBoss count.
  plannedBossCount Int
  createdAt        TimestamptzString @default(now())

  consumableAuditFights RunConsumableAuditFight[]
  warcraftLogsFights    RunWarcraftLogsFight[]

  @@unique([runId, raidId])
  @@unique([runId, sortOrder])
  @@index([raidId])
  @@map("run_raid_content")
}

/// Immutable operational audit record that a Run Start occurred (who/when).
/// Participant roster is snapshotted into RunAttendance; Discord Final Setup
/// is posted asynchronously from that attendance.
model RunStartSnapshot {
  id          String   @id @default(uuid())
  runId       String   @unique
  run         Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  startedAt   TimestamptzString
  startedById String
  startedBy   User     @relation("RunStartStarter", fields: [startedById], references: [id], onDelete: Restrict)
  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()

  @@map("run_start_snapshot")
}

/// A reusable Run-planning preset, always owned by one specific Raid Lead
/// (raidLeadId) — never merely metadata. When a template is used during Run
/// creation, its raidLeadId is the authoritative Raid Lead for every Run
/// created from it, regardless of who applied the template. createdById/
/// updatedById are separate mutation-audit fields (e.g. an ADMIN may create
/// or edit a template owned by a different Raid Lead).
///
/// Deliberately has no relation to Run: applying a template only copies its
/// current field values into a new Run's own concrete planning fields at
/// Global reusable Run Setup (planning preset). Not owned by a Raid Lead —
/// Schedule slots choose WHO; this row defines WHAT + default composition.
/// A later template edit never rewrites any Run created from it — there is no
/// Run.templateId anywhere.
///
/// Authoritative raid identity is ordered `contents` (RunTemplateRaidContent),
/// mirroring RunRaidContent. Never invent Bundle from a singular raid column.
model RunTemplate {
  id                 String         @id @default(uuid())
  name               String
  difficulty         RaidDifficulty
  lootType           RunLootType
  /// Default composition inherited by Schedule slots unless they override.
  desiredTankCount   Int
  desiredHealerCount Int
  desiredDpsCount    Int
  /// Planned Lootbuddy slots — a target only, never a signup or roster entry.
  desiredLootbuddyCount Int @default(0)
  notes              String?
  isActive           Boolean        @default(true)
  createdById        String
  createdBy          User           @relation("RunTemplateCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById        String
  updatedBy          User           @relation("RunTemplateUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()
  communityScheduleSlots CommunityScheduleSlot[]
  contents           RunTemplateRaidContent[]

  @@index([isActive])
  @@map("run_template")
}

/// Ordered real raid instances that belong to one RunTemplate (planning preset).
/// A Bundle template has multiple contents — never a fake aggregated raid.
model RunTemplateRaidContent {
  id               String      @id @default(uuid())
  runTemplateId    String
  runTemplate      RunTemplate @relation(fields: [runTemplateId], references: [id], onDelete: Cascade)
  raidId           String
  raid             Raid        @relation(fields: [raidId], references: [id], onDelete: Restrict)
  /// 1-based deterministic order within the template.
  sortOrder        Int
  /// 1 <= plannedBossCount <= this content Raid's RaidBoss count.
  plannedBossCount Int
  createdAt        TimestamptzString @default(now())

  @@unique([runTemplateId, raidId])
  @@unique([runTemplateId, sortOrder])
  @@index([raidId])
  @@map("run_template_raid_content")
}

/// Recurring community weekly schedule weekday (wall-clock intent).
enum CommunityWeekday {
  @@type("pg/text@1")
  MONDAY    = "MONDAY"
  TUESDAY   = "TUESDAY"
  WEDNESDAY = "WEDNESDAY"
  THURSDAY  = "THURSDAY"
  FRIDAY    = "FRIDAY"
  SATURDAY  = "SATURDAY"
  SUNDAY    = "SUNDAY"
}

/// Management Share classification for a Community Schedule slot (not Run domain).
enum CommunityScheduleRunMode {
  @@type("pg/text@1")
  INHOUSE  = "INHOUSE"
  TEAM_RUN = "TEAM_RUN"
}

/// Persistent COMMUNITY WEEKLY SCHEDULE slot — recurring planning intent.
/// Stores weekday + local HH:mm (Europe/Berlin wall-clock), never a concrete
/// UTC occurrence. Optional RunTemplate + autoCreateRun drive DRAFT Run
/// materialization for CURRENT/NEXT raid-ID windows. Editing/deactivating a
/// slot must never mutate already-materialized Runs (snapshot independence).
/// Discord Schedule remains derived only from real Runs — never from slots.
///
/// Composition: when compositionOverrideEnabled is false, materialization
/// inherits live RunTemplate defaults. When true, the four override counts
/// are a complete composition snapshot for future Runs from this slot.
model CommunityScheduleSlot {
  id             String           @id @default(uuid())
  weekday        CommunityWeekday
  /// Local wall-clock HH:mm in Europe/Berlin (e.g. "19:45"). Never UTC time-of-day.
  localStartTime String
  label          String
  notes          String?
  raidLeadId     String
  raidLead       User             @relation("CommunityScheduleRaidLead", fields: [raidLeadId], references: [id], onDelete: Restrict)
  /// Optional global Run Setup. Required when autoCreateRun is true, and for
  /// manual Create Run from this slot (enforced in service).
  runTemplateId  String?
  runTemplate    RunTemplate?     @relation(fields: [runTemplateId], references: [id], onDelete: Restrict)
  /// When true, hourly reconciliation ensures CURRENT (if still future) and NEXT
  /// occurrences have DRAFT Runs. Turning off never deletes existing Runs.
  autoCreateRun  Boolean          @default(false)
  /// Management Discord Share classification (Inhouse / Team Run). Independent of Run materialization.
  runMode        CommunityScheduleRunMode @default(INHOUSE)
  /// When false, effective composition = RunTemplate defaults. When true, use
  /// the four override columns (all required together — complete override).
  compositionOverrideEnabled Boolean @default(false)
  desiredTankCountOverride       Int?
  desiredHealerCountOverride     Int?
  desiredDpsCountOverride        Int?
  desiredLootbuddyCountOverride  Int?
  isActive       Boolean          @default(true)
  createdById    String
  createdBy      User             @relation("CommunityScheduleCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById    String
  updatedBy      User             @relation("CommunityScheduleUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
  materializations CommunityScheduleRun[]

  /// Same Raid Lead cannot own two slots at the exact same weekday + local time.
  /// Different Raid Leads at the same time are allowed (parallel teams).
  @@unique([raidLeadId, weekday, localStartTime])
  @@index([isActive, weekday, localStartTime], name: "css_active_day_time")
  @@index([raidLeadId, isActive], name: "css_lead_active")
  @@index([runTemplateId], name: "css_template")
  @@index([autoCreateRun, isActive], name: "css_auto_active")
  @@map("community_schedule_slot")
}

/// Durable link: one Community Schedule occurrence per raid-ID window → one Run.
/// While the planning slot exists, identity is (scheduleSlotId, windowStartAt)
/// so editing weekday/time cannot create a second Run in the same window.
/// When the mutable Schedule slot is deleted, scheduleSlotId is SET NULL —
/// the concrete Run and this provenance row remain (window + occurrence times).
model CommunityScheduleRun {
  id                 String                  @id @default(uuid())
  /// Nullable so Admin may delete recurring planning without erasing Runs.
  scheduleSlotId     String?
  scheduleSlot       CommunityScheduleSlot?  @relation(fields: [scheduleSlotId], references: [id], onDelete: SetNull)
  /// Raid-ID window lower bound (Wed 06:00 Europe/Berlin) used for this occurrence.
  windowStartAt      TimestamptzString
  /// Concrete Run scheduledStartAt snapshot at materialization time.
  occurrenceStartAt  TimestamptzString
  runId              String                  @unique
  run                Run                     @relation(fields: [runId], references: [id], onDelete: Restrict)
  createdById        String?
  createdBy          User?                   @relation("CommunityScheduleRunCreator", fields: [createdById], references: [id], onDelete: SetNull)
  /// USER = manual Create Run; SYSTEM = auto-create reconciliation job.
  createdByKind      RunDomainEventActorKind
  createdAt          TimestamptzString       @default(now())

  @@unique([scheduleSlotId, windowStartAt])
  @@index([scheduleSlotId, windowStartAt], name: "csr_slot_window")
  @@map("community_schedule_run")
}

/// A user may offer more than one character for the same run.
/// Duplicate prevention is per run + user + character + participation type.
/// Withdrawn rows still occupy that unique key; a later signup of the same
/// combination revives the row instead of inserting a second record.
///
/// BOOSTER role volunteering lives on RunSignupRole (offeredRoles).
/// Mutable draft assignment lives on RunRosterEntry.selectedRole.
/// Live published assignment lives here as publishedRole (null until SELECTED).
model RunSignup {
  id                    String                 @id @default(uuid())
  runId                 String
  run                   Run                    @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId           String?
  character             Character?             @relation(fields: [characterId], references: [id], onDelete: SetNull)
  participationType     ParticipationType
  isBackup              Boolean                @default(false)
  status                SignupStatus
  /// Role assigned when the roster was last published. Set only for SELECTED
  /// BOOSTER rows; always null for LOOTBUDDY and for non-SELECTED statuses.
  /// Replacement-draft edits never mutate this until Publish runs again.
  publishedRole         CharacterRole?
  /// Characterless Lootbuddy's own Class snapshot — required for a new (characterId
  /// null) Lootbuddy row going forward. Null on Booster rows and on legacy
  /// Character-backed Lootbuddy rows predating this field (display falls back to
  /// character.wowClass for those). Never used for Booster eligibility.
  lootbuddyClass        WowClass?
  lootbuddyMode         LootbuddyMode?
  lootbuddyVerification LootbuddyVerification?
  notes                 String?
  /// Reason a picked (roster-selected) player gave when withdrawing. Required
  /// for that withdrawal and sent to the Raid Lead; null for every other row.
  withdrawReason        String?
  createdAt             TimestamptzString      @default(now())
  updatedAt             temporal.updatedAtString()

  offeredRoles  RunSignupRole[]
  rosterEntries RunRosterEntry[]
  payoutEntries RunPayoutEntry[]
  notifications UserNotification[]

  /// NULL is distinct per row under Postgres unique-index semantics, so this does
  /// NOT limit a User to one characterless (characterId null) LOOTBUDDY row per
  /// Run — multiple such rows are intentional. It still prevents offering the
  /// same Character twice for the same participationType, which remains the
  /// invariant for Character-backed rows (BOOSTER, and legacy Character-backed
  /// LOOTBUDDY).
  @@unique([runId, userId, characterId, participationType])
  @@index([userId])
  @@index([runId])
  @@map("run_signup")
}

/// One volunteered role for a BOOSTER RunSignup. A Character may offer multiple
/// roles on the same Run without creating multiple signup rows or roster slots.
model RunSignupRole {
  id        String        @id @default(uuid())
  signupId  String
  signup    RunSignup     @relation(fields: [signupId], references: [id], onDelete: Cascade)
  role      CharacterRole
  createdAt TimestamptzString @default(now())

  @@unique([signupId, role])
  @@index([signupId])
  @@map("run_signup_role")
}

/// One persisted roster per run. Draft selection lives in RunRosterEntry and is
/// independent of RunSignup.status until Publish copies the draft into SELECTED /
/// NOT_SELECTED. Editing after publish mutates the draft only; the live roster
/// stays on signup statuses until a replacement publish succeeds.
model RunRoster {
  id            String      @id @default(uuid())
  runId         String      @unique
  run           Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  state         RosterState @default(DRAFT)
  version       Int         @default(1)
  publishedAt   TimestamptzString?
  publishedById String?
  publishedBy   User?       @relation("RosterPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  /// A roster-relevant Run setting (difficulty, content, schedule, loot type,
  /// composition targets) changed after the roster was last accepted by
  /// Publish / Update Roster. Start is refused while true.
  runChangedSinceAck Boolean  @default(false)
  /// Latest explicit Publish Roster intent (first post and every deliberate
  /// republish). The bot syncs the single persistent Roster message while this
  /// exceeds RunDiscordPost.lastRosterPostRevision.
  postRevision  Int         @default(0)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  entries          RunRosterEntry[]
  externalBoosters RunExternalBooster[]

  @@map("run_roster")
}

model RunAttendance {
  id            String           @id @default(uuid())
  runId         String
  run           Run              @relation(fields: [runId], references: [id], onDelete: Cascade)
  rosterEntryId String           @unique
  rosterEntry   RunRosterEntry   @relation(fields: [rosterEntryId], references: [id], onDelete: Restrict)
  status        AttendanceStatus @default(UNMARKED)
  note          String?
  markedAt      TimestamptzString?
  markedById    String?
  markedBy      User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  payoutEntry RunPayoutEntry?
  consumableAuditPlayers RunConsumableAuditPlayer[]

  @@index([runId])
  @@index([status])
  @@map("run_attendance")
}

/// A booster added by the Raid Lead who is not registered on the website
/// (e.g. an in-house helper). Saved with the roster draft (Save Roster),
/// counts toward the role targets and is shown as `@name <class>` in the
/// Discord roster / Final Setup. Never part of signups, attendance, payouts,
/// strikes or notifications.
model RunExternalBooster {
  id        String        @id @default(uuid())
  rosterId  String
  roster    RunRoster     @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  /// Display name (usually the Discord name), rendered as `@name`.
  name              String
  wowClass          WowClass
  /// BOOSTER fills a Tank/Healer/DPS slot; LOOTBUDDY is an unregistered lootbuddy.
  participationType ParticipationType @default(BOOSTER)
  /// Required for BOOSTER; always null for LOOTBUDDY.
  role              CharacterRole?
  createdAt         TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  consumableAuditPlayers RunConsumableAuditPlayer[]

  @@index([rosterId])
  @@map("run_external_booster")
}

model RunRosterEntry {
  id           String         @id @default(uuid())
  rosterId     String
  roster       RunRoster      @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  signupId     String
  signup       RunSignup      @relation(fields: [signupId], references: [id], onDelete: Cascade)
  selected     Boolean        @default(true)
  /// Final role the Raid Lead assigns in the *current saved draft* for this
  /// BOOSTER roster slot. Mutable independently of RunSignup.publishedRole.
  /// Required when selected and participation is BOOSTER; always null for LOOTBUDDY.
  selectedRole CharacterRole?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  attendance   RunAttendance?
  payoutEntries RunPayoutEntry[]

  @@unique([rosterId, signupId])
  @@index([rosterId])
  @@map("run_roster_entry")
}

/// One gold settlement per completed Run. Amounts are whole WoW gold integers.
/// Display snapshots are frozen at finalize; DRAFT may still refresh from live joins.
/// totalGold is the GROSS pot: mutable while DRAFT, frozen at FINALIZED.
/// Community cut BPS fields are snapshotted at prepare from current Dawn policy
/// (Booster 62.5%, Raid Lead 3%, Advertiser 30%; Dawn is residual).
/// raidLeadCutMode selects KEEP (RL keeps 3%) or SHARE (3% joins Booster Pool).
model RunSettlement {
  id               String           @id @default(uuid())
  runId            String           @unique
  run              Run              @relation(fields: [runId], references: [id], onDelete: Cascade)
  totalGold        Int
  raidLeadCutMode  RaidLeadCutMode  @default(SHARE)
  boosterCutBps    Int              @default(6250)
  raidLeadCutBps   Int              @default(300)
  advertiserCutBps Int              @default(3000)
  status           SettlementStatus @default(DRAFT)
  preparedById     String
  preparedBy       User             @relation("SettlementPreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  finalizedAt      TimestamptzString?
  finalizedById    String?
  finalizedBy      User?            @relation("SettlementFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  paidAt           TimestamptzString?
  paidById         String?
  paidBy           User?            @relation("SettlementPayer", fields: [paidById], references: [id], onDelete: SetNull)
  runTitle         String
  raidName         String
  difficulty       RaidDifficulty
  raidLeadName     String
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  entries RunPayoutEntry[]

  @@index([status])
  @@map("run_settlement")
}

/// One attendance-derived payout line. Zero-share rows are kept for audit history.
model RunPayoutEntry {
  id                String            @id @default(uuid())
  settlementId      String
  settlement        RunSettlement     @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  attendanceId      String            @unique
  attendance        RunAttendance     @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  rosterEntryId     String
  rosterEntry       RunRosterEntry    @relation(fields: [rosterEntryId], references: [id], onDelete: Restrict)
  signupId          String
  signup            RunSignup         @relation(fields: [signupId], references: [id], onDelete: Restrict)
  userId            String
  user              User              @relation("PayoutRecipient", fields: [userId], references: [id], onDelete: Restrict)
  characterId       String?
  character         Character?        @relation(fields: [characterId], references: [id], onDelete: SetNull)
  userDisplayName   String
  characterName     String
  characterRealm    String
  characterRegion   WowRegion?
  participationType ParticipationType
  attendanceStatus  AttendanceStatus
  role              CharacterRole?
  isBackup          Boolean
  shareUnits        Int
  amountGold        Int
  adjustmentReason  String?
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([settlementId])
  @@index([userId])
  @@map("run_payout_entry")
}

model ActivityEvent {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String
  message     String
  occurredAt  TimestamptzString @default(now())

  @@index([occurredAt])
  @@map("activity_event")
}

/// Disciplinary history record against a User. Creation is always an
/// explicit staff action — never automatic. Subject is always User (never
/// Character) so history survives role changes, Character deactivation, and
/// Boosting Role changes. No hard delete; REVOKED is a staff
/// correction, not an expiry (there is no automatic expiry here).
///
/// Attendance and payout/financial-deduction handling are owned by the
/// external Dawn Boosting operational workflow, not BoostingHub — Strike
/// intentionally has no relation to RunAttendance or any financial record.
model Strike {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation("StrikeSubject", fields: [userId], references: [id], onDelete: Restrict)
  runId         String?
  run           Run?              @relation(fields: [runId], references: [id], onDelete: SetNull)
  reason        String
  notes         String?
  status        StrikeStatus      @default(ACTIVE)
  createdById   String
  createdBy     User              @relation("StrikeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revokedAt     TimestamptzString?
  revokedById   String?
  revokedBy     User?             @relation("StrikeRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedReason String?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([userId])
  @@index([runId])
  @@map("strike")
}

/// Discord message identity for one Run's public posts. Presentation-only
/// integration state — never authoritative Run/Signup/Roster data, which the
/// Discord bot always re-derives from BoostingHub via the Bot API. Exists so
/// the bot can edit its own prior post instead of spamming a new message on
/// every sync pass, and survives a bot restart.
model RunDiscordPost {
  id                  String   @id @default(uuid())
  runId               String   @unique
  run                 Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The Run's dedicated Discord text channel, when per-Run channel
  /// provisioning is enabled (bot-side DISCORD_RUN_CATEGORY_ID configured).
  /// Recorded as soon as the channel is created — independent of whether a
  /// signup message has been posted into it yet — so a crash between
  /// creation and posting never creates a second channel on retry. Identity
  /// is this id, never the generated name (names may be renamed later).
  runChannelId        String?
  /// Temporary Discord GuildVoice channel for an IN_PROGRESS Run (bot-side
  /// DISCORD_RUN_VOICE_CATEGORY_ID configured). Created once on start; kept
  /// while the Run is IN_PROGRESS; after COMPLETED / CANCELLED / app-archive
  /// it is deleted only once nobody is connected, then this is cleared.
  voiceChannelId      String?
  signupChannelId     String?
  signupMessageId     String?
  signupPostedAt      TimestamptzString?
  /// Cheap fingerprint (e.g. unique signup count + window state) to detect
  /// whether the posted signup embed is stale without re-rendering it.
  lastSignupSignature String?
  rosterChannelId     String?
  rosterMessageId     String?
  rosterPostedAt      TimestamptzString?
  /// RunRoster.version at last successful roster post, to detect republish.
  lastRosterVersion   Int?
  /// RunRoster.postRevision the bot last fulfilled on the persistent Roster
  /// message. Null = no explicit Publish fulfilled yet (treated as 0).
  lastRosterPostRevision Int?
  /// Guild emoji fingerprint (class + role emoji ids) the posted roster embed
  /// was rendered with. Differing from the bot's current fingerprint means
  /// the roster message is edited in place. Null for posts made before this
  /// existed (refreshed once on the first pass).
  lastRosterEmojiFingerprint String?
  /// Operational Run Start roster post (separate from signup + published roster).
  startChannelId      String?
  startMessageId      String?
  /// RunRoster.version the posted Final Setup reflects. A replacement after
  /// Start bumps the roster version, so a differing value means the post must
  /// be edited. Null for posts made before this existed (never re-edited
  /// unless a replacement sets the baseline first).
  lastStartRosterVersion Int?
  /// Voice channel id the posted Final Setup links (null = no Voice line).
  /// Differing from voiceChannelId while the Run is running means the post
  /// must be edited to add, replace or remove the Voice mention.
  lastStartVoiceChannelId String?
  startPostedAt      TimestamptzString?
  /// Ticket-Tool-style close banner posted once when the Run is app-archived.
  archiveCloseMessageId      String?
  /// HTML transcript attachment message posted once on app-archive (may equal close message id when posted together).
  archiveTranscriptMessageId String?
  /// Full HTML transcript body for website download (same content attached on Discord).
  archiveTranscriptHtml      String?
  /// Download filename, e.g. transcript-closed-….html
  archiveTranscriptFilename  String?
  /// JSON array of RunSignup ids that already received an Apex-style Raid Invite DM
  /// (sent after Start Run, not on roster publish).
  raidInviteSentSignupIds    String?
  /// Newest Run-channel message id the Warcraft Logs link scan has fully
  /// processed (Discord snowflake). Only ever moves forward; null = not
  /// scanned yet (the first scan starts from the Run start time).
  warcraftLogsScanCursor     String?
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()

  @@map("run_discord_post")
}

/// Raid-ID week bucket for the global Discord Schedule posts (#current-id / #next-id).
enum DiscordScheduleBucket {
  @@type("pg/text@1")
  CURRENT = "CURRENT"
  NEXT    = "NEXT"
}

/// Global persistent Schedule message per CURRENT/NEXT marker channel.
/// Not per-Run — one row per bucket. Bot creates/edits the Discord message;
/// BoostingHub stores message identity + last render signature.
model DiscordSchedulePost {
  id            String                @id @default(uuid())
  bucket        DiscordScheduleBucket @unique
  channelId     String?
  messageId     String?
  lastSignature String?
  createdAt     TimestamptzString     @default(now())
  updatedAt     temporal.updatedAtString()

  @@map("discord_schedule_post")
}

/// Durable Run-channel lifecycle announcement (reschedule / cancel).
/// Shared channel communication — never gated by User DM preferences.
/// Distinct from UserNotification rows. Idempotent via sourceKey.
model RunDiscordAnnouncement {
  id                       String                     @id @default(uuid())
  runId                    String
  run                      Run                        @relation(fields: [runId], references: [id], onDelete: Cascade)
  type                     RunDiscordAnnouncementType
  /// e.g. run-rescheduled:<runId>:<scheduleRevision> or run-cancelled:<runId>
  sourceKey                String                     @unique
  previousScheduledStartAt TimestamptzString?
  scheduledStartAt         TimestamptzString
  /// Snapshot for channel message rendering (Run title may still change later).
  productLabel             String
  difficulty               RaidDifficulty
  lootType                 RunLootType
  status                   DiscordDeliveryStatus
  createdAt                TimestamptzString          @default(now())
  sentAt                   TimestamptzString?
  updatedAt                temporal.updatedAtString()

  @@index([status, createdAt])
  @@index([runId, createdAt])
  @@map("run_discord_announcement")
}

/// Why the latest Consumables Audit analysis attempt produced no new snapshot.
/// Safe fixed categories only — never a raw Warcraft Logs error message.
enum ConsumableAuditFailure {
  @@type("pg/text@1")
  NOT_CONFIGURED     = "NOT_CONFIGURED"
  REPORT_NOT_FOUND   = "REPORT_NOT_FOUND"
  NO_RELEVANT_FIGHTS = "NO_RELEVANT_FIGHTS"
  WCL_UNAVAILABLE    = "WCL_UNAVAILABLE"
}

/// How a Run participant was resolved to a Warcraft Logs report actor.
enum ConsumableAuditMatch {
  @@type("pg/text@1")
  /// Character identity (warcraftLogsId or name + realm + region) found in the report.
  MATCHED               = "MATCHED"
  /// Character identity known, but no such player actor in the report.
  NOT_IN_LOG            = "NOT_IN_LOG"
  /// No character identity to match safely (e.g. external booster: Discord name only).
  NO_CHARACTER_IDENTITY = "NO_CHARACTER_IDENTITY"
}

/// One normalized Warcraft Logs fact about one player in one fight.
enum ConsumableObservationKind {
  @@type("pg/text@1")
  /// CombatantInfo snapshot at pull exists — auras at pull are known.
  COMBATANT   = "COMBATANT"
  /// In the fight (friendlyPlayers) without a CombatantInfo snapshot — auras unknown.
  PARTICIPANT = "PARTICIPANT"
  /// Catalog aura active at pull (e.g. FLASK).
  AURA        = "AURA"
  /// Catalog consumable cast (potion, Healthstone).
  CAST        = "CAST"
  DEATH       = "DEATH"
}

/// Post-run Consumables Audit snapshot for one Run (ADMIN / assigned RAID_LEAD
/// only — see docs/features/run-consumables-audit.md). Built ONLY from the
/// fights ASSIGNED to this Run (RunWarcraftLogsFight), never a whole report.
/// Stores normalized WCL facts; PASS/WARNING/N/A policy is evaluated at read
/// time so rule changes never require re-fetching Warcraft Logs. Children are
/// replaced atomically on every successful analysis; a failed attempt keeps
/// the previous snapshot.
model RunConsumableAudit {
  id            String                  @id @default(uuid())
  runId         String                  @unique
  run           Run                     @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// Latest SUCCESSFUL analysis. Null until the first success.
  analyzedAt    TimestamptzString?
  analyzedById  String?
  analyzedBy    User?                   @relation("ConsumableAuditAnalyzer", fields: [analyzedById], references: [id], onDelete: SetNull)
  /// Latest attempt, successful or not (refresh cooldown basis).
  lastAttemptAt TimestamptzString
  /// Null when the latest attempt succeeded.
  lastFailure   ConsumableAuditFailure?
  /// Automatic (post-completion) attempts so far — capped by the auto-audit job.
  autoAttempts  Int                     @default(0)
  /// The latest successful analysis ran automatically (no acting user).
  autoAnalyzed  Boolean                 @default(false)
  /// Shape of the stored facts: 1 = before played roles (no specId), 2 = COMBATANT rows carry specId.
  factsVersion  Int                     @default(1)
  createdAt     TimestamptzString       @default(now())
  updatedAt     temporal.updatedAtString()

  fights  RunConsumableAuditFight[]
  players RunConsumableAuditPlayer[]

  @@map("run_consumable_audit")
}

/// One Warcraft Logs boss fight (kill or wipe) included in a Consumables Audit.
model RunConsumableAuditFight {
  id             String             @id @default(uuid())
  auditId        String
  audit          RunConsumableAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  /// Warcraft Logs report the fight came from (a Run may use several reports).
  reportCode     String
  /// Report-local WCL fight id.
  wclFightId     Int
  /// WCL encounter id (wow-raid-catalog warcraftLogsEncounterIds).
  encounterId    Int
  encounterName  String
  kill           Boolean
  /// WCL difficulty (3 Normal, 4 Heroic, 5 Mythic); null when not reported.
  difficulty     Int?
  /// Report-relative milliseconds.
  startMs        Int
  endMs          Int
  /// The Run content this encounter belongs to, when the catalog maps it.
  raidContentId  String?
  raidContent    RunRaidContent?    @relation(fields: [raidContentId], references: [id], onDelete: SetNull)
  /// A Warlock actor took part in this fight. Null when WCL did not report the
  /// fight participants (Healthstone applicability then rests on healthstoneUseSeen).
  warlockPresent     Boolean?
  /// Any friendly player (audited or not) used a Healthstone in this fight —
  /// direct proof Healthstones existed.
  healthstoneUseSeen Boolean

  observations RunConsumableAuditObservation[]
  gearItems    RunConsumableAuditGearItem[]

  @@unique([auditId, reportCode, wclFightId])
  @@index([auditId])
  @@map("run_consumable_audit_fight")
}

/// One audited Run booster (attended BOOSTER roster participant or external
/// booster) and how it resolved to a WCL actor. Display fields are snapshots.
model RunConsumableAuditPlayer {
  id                String               @id @default(uuid())
  auditId           String
  audit             RunConsumableAudit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  attendanceId      String?
  attendance        RunAttendance?       @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  externalBoosterId String?
  externalBooster   RunExternalBooster?  @relation(fields: [externalBoosterId], references: [id], onDelete: SetNull)
  displayName       String
  characterName     String?
  characterRealm    String?
  wowClass          WowClass?
  /// Roster (planned/published) role — reference only; the played role comes from COMBATANT specIds.
  role              CharacterRole?
  matchStatus       ConsumableAuditMatch
  /// Report-local WCL actor id when MATCHED.
  wclActorId        Int?
  sortOrder         Int

  observations RunConsumableAuditObservation[]
  gearItems    RunConsumableAuditGearItem[]

  @@index([auditId])
  @@map("run_consumable_audit_player")
}

/// Normalized WCL fact: a player's presence, aura at pull, consumable cast or
/// death in one fight. `category` is a consumable-catalog category (text, so
/// future checks such as food or runes need no enum migration).
model RunConsumableAuditObservation {
  id       String                    @id @default(uuid())
  playerId String
  player   RunConsumableAuditPlayer  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fightId  String
  fight    RunConsumableAuditFight   @relation(fields: [fightId], references: [id], onDelete: Cascade)
  kind     ConsumableObservationKind
  category String?
  spellId  Int?
  /// COMBATANT only: Blizzard specialization id played in that fight (WCL CombatantInfo specID).
  specId   Int?
  /// Report-relative milliseconds.
  atMs     Int

  @@index([playerId])
  @@index([fightId])
  @@map("run_consumable_audit_observation")
}

/// Gear Readiness fact: one equipped item of an audited player at one audited
/// fight's pull (Warcraft Logs CombatantInfo gear). Only enchantable slots,
/// weapons and socketed items are stored. Enchant / gem / weapon-enhancement
/// statuses are evaluated at read time (gear-readiness-policy.ts).
model RunConsumableAuditGearItem {
  id                 String                   @id @default(uuid())
  playerId           String
  player             RunConsumableAuditPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  fightId            String
  fight              RunConsumableAuditFight  @relation(fields: [fightId], references: [id], onDelete: Cascade)
  /// Position in the WCL gear array = equipment slot (0 Head … 15 Main Hand, 16 Off Hand).
  slot               Int
  itemId             Int
  /// SpellItemEnchantment ids as WCL reports them; null = none.
  permanentEnchantId Int?
  temporaryEnchantId Int?
  gemCount           Int
  /// Sockets from game data (base + bonus sockets); null = unknown.
  socketCount        Int?

  @@unique([playerId, fightId, slot])
  @@index([fightId])
  @@map("run_consumable_audit_gear_item")
}

/// Where a Warcraft Logs fight stands for one Run.
enum WarcraftLogsFightStatus {
  @@type("pg/text@1")
  /// Part of this Run — the only fights the Consumables Audit reads.
  ASSIGNED     = "ASSIGNED"
  /// Evidence is ambiguous (overlapping Run windows, unknown Run end, low
  /// roster overlap). Never audited until a manager decides.
  NEEDS_REVIEW = "NEEDS_REVIEW"
  /// In the Run's time window but not part of it (other content, another Run).
  IGNORED      = "IGNORED"
}

/// How a report got linked to a Run.
enum WarcraftLogsReportSource {
  @@type("pg/text@1")
  /// Pasted by an ADMIN / the Run's RAID_LEAD.
  MANUAL      = "MANUAL"
  /// Posted by a trusted log bot (DISCORD_WCL_REPORT_AUTHOR_IDS) in the Run's own Discord channel.
  DISCORD_BOT = "DISCORD_BOT"
}

/// Who decided a fight's status. MANUAL decisions survive re-scans.
enum WarcraftLogsFightDecision {
  @@type("pg/text@1")
  AUTO   = "AUTO"
  MANUAL = "MANUAL"
}

/// A Warcraft Logs report — a shared external resource. One report may hold
/// several consecutive BoostingHub Runs; which fight belongs to which Run lives
/// in RunWarcraftLogsFight, never here.
model WarcraftLogsReport {
  id           String            @id @default(uuid())
  /// WCL report code (the `/reports/<code>` path segment).
  code         String            @unique
  title        String?
  /// Absolute wall-clock bounds. WCL fight times are relative to startAt.
  startAt      TimestamptzString
  endAt        TimestamptzString
  /// Uppercase WCL region slug ("EU", "US").
  regionSlug   String?
  /// Cached report metadata (boss fights, player actors, ranked characters) as
  /// JSON, reused by every Run attached to this report until the next re-scan.
  metadataJson String
  fetchedAt    TimestamptzString
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  runs   RunWarcraftLogsReport[]
  fights RunWarcraftLogsFight[]

  @@map("warcraft_logs_report")
}

/// A Run uses a Warcraft Logs report (1 report → many Runs, 1 Run → many reports).
model RunWarcraftLogsReport {
  id            String             @id @default(uuid())
  runId         String
  run           Run                @relation(fields: [runId], references: [id], onDelete: Cascade)
  reportId      String
  report        WarcraftLogsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// Null for system attachments (DISCORD_BOT).
  createdById   String?
  createdBy     User?              @relation("WarcraftLogsReportAttacher", fields: [createdById], references: [id], onDelete: SetNull)
  source           WarcraftLogsReportSource @default(MANUAL)
  /// The Discord message the report link was read from (DISCORD_BOT only).
  discordMessageId String?
  /// The trusted Discord author (log bot / webhook) that posted it (DISCORD_BOT only).
  discordAuthorId  String?
  /// Latest fight assignment scan for this Run. Null until first scanned (a
  /// report attached by the log bot while the Run is still IN_PROGRESS).
  lastScannedAt TimestamptzString?
  createdAt     TimestamptzString  @default(now())
  updatedAt     temporal.updatedAtString()

  fights RunWarcraftLogsFight[]

  @@unique([runId, reportId])
  @@index([reportId])
  @@map("run_warcraft_logs_report")
}

/// One report fight considered for one Run, with its assignment status and the
/// evidence behind it. A (report, fight) pair is ASSIGNED to at most one Run —
/// enforced by the partial unique index below; moving it is a reassignment.
model RunWarcraftLogsFight {
  id             String                    @id @default(uuid())
  associationId  String
  association    RunWarcraftLogsReport     @relation(fields: [associationId], references: [id], onDelete: Cascade)
  runId          String
  run            Run                       @relation(fields: [runId], references: [id], onDelete: Cascade)
  reportId       String
  report         WarcraftLogsReport        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  wclFightId     Int
  encounterId    Int
  encounterName  String
  kill           Boolean
  difficulty     Int?
  /// Report-relative milliseconds (as WCL reports them).
  startMs        Int
  endMs          Int
  /// Absolute wall-clock time: report.startAt + startMs / endMs.
  startAt        TimestamptzString
  endAt          TimestamptzString
  raidContentId  String?
  raidContent    RunRaidContent?           @relation(fields: [raidContentId], references: [id], onDelete: SetNull)
  status         WarcraftLogsFightStatus
  decision       WarcraftLogsFightDecision
  /// JSON array of evidence codes (e.g. TIME_MATCH, MULTIPLE_RUN_WINDOWS).
  reasons        String
  /// Run roster members found among the fight's players / Run roster members
  /// with a character identity. Null when not computable.
  rosterMatched  Int?
  rosterSize     Int?
  decidedById    String?
  decidedBy      User?                     @relation("WarcraftLogsFightDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  createdAt      TimestamptzString         @default(now())
  updatedAt      temporal.updatedAtString()

  @@unique([runId, reportId, wclFightId])
  @@index([associationId])
  @@index([reportId, wclFightId], unique: true, where: "(\"status\" = 'ASSIGNED'::text)", name: "run_wcl_fight_assigned_once")
  @@map("run_warcraft_logs_fight")
}

/// Where a Warcraft Logs report found in a dedicated Discord log channel stands.
enum WarcraftLogsDiscoveryStatus {
  @@type("pg/text@1")
  /// Not matched yet (no boss fights, no completed Run in its time span, WCL unreachable) — retried.
  PENDING      = "PENDING"
  /// Linked to every Run its fights were assigned to.
  MATCHED      = "MATCHED"
  /// Linked, but some fights need a manager's decision on the Run page.
  NEEDS_REVIEW = "NEEDS_REVIEW"
  /// Settled without a Run (report missing / private, or no Run matched in time). Not retried.
  IGNORED      = "IGNORED"
}

/// A report link the trusted log bot posted in a dedicated log channel
/// (DISCORD_WCL_REPORT_CHANNEL_IDS). The server matches it to Runs with the
/// same fight assignment as the Consumables Audit and links it to each Run
/// its fights belong to; retried with backoff until settled.
model WarcraftLogsReportDiscovery {
  id            String                      @id @default(uuid())
  /// Source Discord channel + message (a message can name several reports).
  channelId     String
  messageId     String
  authorId      String
  reportCode    String
  /// Message time (from the snowflake).
  postedAt      TimestamptzString
  status        WarcraftLogsDiscoveryStatus @default(PENDING)
  attempts      Int                         @default(0)
  /// Next evaluation; null once settled.
  nextAttemptAt TimestamptzString?
  lastAttemptAt TimestamptzString?
  /// Safe reason code of the latest evaluation (never a raw error).
  lastOutcome   String?
  /// JSON array of the Run ids the report is linked to.
  linkedRunIds  String                      @default("[]")
  createdAt     TimestamptzString           @default(now())
  updatedAt     temporal.updatedAtString()

  @@unique([channelId, messageId, reportCode])
  @@index([nextAttemptAt])
  @@map("warcraft_logs_report_discovery")
}

/// Durable read position of the bot in a dedicated Warcraft Logs log channel.
/// Survives restarts, so history is never re-read from the start.
model DiscordChannelScanCursor {
  channelId     String            @id
  /// Newest fully processed Discord message id (only moves forward).
  lastMessageId String
  updatedAt     temporal.updatedAtString()

  @@map("discord_channel_scan_cursor")
}

/// One-time Discord product / release announcement delivery record.
/// Distinct from RunDiscordPost, RunDiscordAnnouncement, and Schedule posts.
/// After a successful send, the row is permanent — deleting the Discord
/// message must not trigger a repost.
model DiscordGlobalAnnouncement {
  key       String            @id
  channelId String
  messageId String
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  @@map("discord_global_announcement")
}

/// Integration / System Health telemetry providers.
/// Distinct from ActivityEvent (user/domain feed). Never stores secrets.
enum IntegrationProvider {
  @@type("pg/text@1")
  BLIZZARD       = "BLIZZARD"
  WARCRAFT_LOGS  = "WARCRAFT_LOGS"
  DISCORD        = "DISCORD"
  RAIDER_IO      = "RAIDER_IO"
  SYSTEM         = "SYSTEM"
  BACKUP         = "BACKUP"
}

/// Outcome of one IntegrationEvent. WARNING is degraded-but-continuing.
enum IntegrationEventStatus {
  @@type("pg/text@1")
  SUCCESS = "SUCCESS"
  WARNING = "WARNING"
  ERROR   = "ERROR"
}

/// Structured integration telemetry for System Health.
/// Not a KPI warehouse and not ActivityEvent.
/// Retention: purge events older than 30 days via scheduled maintenance.
model IntegrationEvent {
  id           String                 @id @default(uuid())
  provider     IntegrationProvider
  /// Stable operation key (e.g. SCHEDULED_SYNC_PASS, DISCORD_SYNC_ONCE).
  operation    String
  status       IntegrationEventStatus
  createdAt    TimestamptzString      @default(now())
  durationMs   Int?
  httpStatus   Int?
  /// Safe DomainError / provider code — never a raw stack or token.
  errorCode    String?
  entityType   String?
  entityId     String?
  region       WowRegion?
  /// Sanitized JSON object string. Never tokens, Authorization, message bodies.
  metadataJson String?

  @@index([createdAt])
  @@index([provider, createdAt])
  @@index([status, createdAt])
  @@index([provider, operation, createdAt])
  @@map("integration_event")
}

/// Who produced a RunDomainEvent. SYSTEM never fabricates a user actor.
enum RunDomainEventActorKind {
  @@type("pg/text@1")
  USER   = "USER"
  SYSTEM = "SYSTEM"
}

/// Run-scoped business audit trail. Not ActivityEvent and not IntegrationEvent.
/// Meaningful lifecycle events only — never every persistence write.
model RunDomainEvent {
  id          String                 @id @default(uuid())
  runId       String
  run         Run                    @relation(fields: [runId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?                  @relation("RunDomainEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorKind   RunDomainEventActorKind
  /// Stable event type key (e.g. RUN_CREATED, ROSTER_PUBLISHED).
  type        String
  /// Short human-readable summary for History UI.
  summary     String
  /// Sanitized JSON object string for optional before/after detail. Never secrets.
  payloadJson String?
  occurredAt  TimestamptzString      @default(now())

  @@index([runId, occurredAt])
  @@index([occurredAt])
  @@index([type, occurredAt])
  @@map("run_domain_event")
}
