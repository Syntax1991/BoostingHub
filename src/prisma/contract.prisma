// Boostting Bot domain contract.
// Prisma 8 stores enums as text columns with CHECK constraints, not native PG enums.

enum AccountRole {
  @@type("pg/text@1")
  USER      = "USER"
  RAID_LEAD = "RAID_LEAD"
  ADMIN     = "ADMIN"
}

enum AccountStatus {
  @@type("pg/text@1")
  ACTIVE   = "ACTIVE"
  DISABLED = "DISABLED"
}

enum WowClass {
  @@type("pg/text@1")
  DEATH_KNIGHT = "DEATH_KNIGHT"
  DEMON_HUNTER = "DEMON_HUNTER"
  DRUID        = "DRUID"
  EVOKER       = "EVOKER"
  HUNTER       = "HUNTER"
  MAGE         = "MAGE"
  MONK         = "MONK"
  PALADIN      = "PALADIN"
  PRIEST       = "PRIEST"
  ROGUE        = "ROGUE"
  SHAMAN       = "SHAMAN"
  WARLOCK      = "WARLOCK"
  WARRIOR      = "WARRIOR"
}

enum CharacterRole {
  @@type("pg/text@1")
  TANK   = "TANK"
  HEALER = "HEALER"
  DPS    = "DPS"
}

enum WowRegion {
  @@type("pg/text@1")
  EU = "EU"
  US = "US"
}

enum RaidDifficulty {
  @@type("pg/text@1")
  NORMAL = "NORMAL"
  HEROIC = "HEROIC"
  MYTHIC = "MYTHIC"
}

/// Independent of RaidDifficulty. Compatibility (e.g. MYTHIC cannot be SAVED)
/// is a domain rule enforced in the Service layer, not a schema constraint.
enum RunLootType {
  @@type("pg/text@1")
  SAVED   = "SAVED"
  UNSAVED = "UNSAVED"
  VIP     = "VIP"
}

enum BoosterAccessStatus {
  @@type("pg/text@1")
  PENDING  = "PENDING"
  APPROVED = "APPROVED"
  REJECTED = "REJECTED"
  REVOKED  = "REVOKED"
}

/// Current BoosterQualification lifecycle. PENDING belongs only to legacy BoosterAccess.
enum BoosterQualificationStatus {
  @@type("pg/text@1")
  APPROVED = "APPROVED"
  REVOKED  = "REVOKED"
}

enum RunStatus {
  @@type("pg/text@1")
  DRAFT       = "DRAFT"
  OPEN        = "OPEN"
  ROSTERING   = "ROSTERING"
  PUBLISHED   = "PUBLISHED"
  IN_PROGRESS = "IN_PROGRESS"
  COMPLETED   = "COMPLETED"
  CANCELLED   = "CANCELLED"
}

enum SignupStatus {
  @@type("pg/text@1")
  PENDING      = "PENDING"
  SELECTED     = "SELECTED"
  NOT_SELECTED = "NOT_SELECTED"
  WITHDRAWN    = "WITHDRAWN"
}

enum ParticipationType {
  @@type("pg/text@1")
  BOOSTER   = "BOOSTER"
  LOOTBUDDY = "LOOTBUDDY"
}

enum LootbuddyMode {
  @@type("pg/text@1")
  LOOT_ONLY = "LOOT_ONLY"
  PLAYING   = "PLAYING"
}

enum LootbuddyVerification {
  @@type("pg/text@1")
  NONE   = "NONE"
  ACCESS = "ACCESS"
  TRIAL  = "TRIAL"
}

/// Draft until the first successful publish; stays PUBLISHED while a replacement draft is edited.
enum RosterState {
  @@type("pg/text@1")
  DRAFT     = "DRAFT"
  PUBLISHED = "PUBLISHED"
}

/// Operational attendance for one published selected roster participant.
enum AttendanceStatus {
  @@type("pg/text@1")
  UNMARKED    = "UNMARKED"
  PRESENT     = "PRESENT"
  LATE        = "LATE"
  LEFT_EARLY  = "LEFT_EARLY"
  NO_SHOW     = "NO_SHOW"
  EXCUSED     = "EXCUSED"
  STANDBY     = "STANDBY"
}

/// Bookkeeping lifecycle for one completed-run gold settlement. Not a wallet.
enum SettlementStatus {
  @@type("pg/text@1")
  DRAFT     = "DRAFT"
  FINALIZED = "FINALIZED"
  PAID      = "PAID"
}

/// No hard delete. REVOKED is a staff correction, not an expiry — there is no
/// automatic expiry status in this contract.
enum StrikeStatus {
  @@type("pg/text@1")
  ACTIVE  = "ACTIVE"
  REVOKED = "REVOKED"
}

/// Application account. Also serves as the Better Auth `user` table.
/// Account roles are permissions on the platform, not run participation type.
model User {
  id              String        @id @default(uuid())
  name            String
  email           String?       @unique
  emailVerified   Boolean       @default(false)
  image           String?
  discordUserId   String?       @unique
  discordUsername String?
  accountStatus   AccountStatus @default(ACTIVE)
  accountRole     AccountRole   @default(USER)
  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()

  sessions      Session[]
  accounts      Account[]
  characters     Character[]
  boosterAccess  BoosterAccess[] @relation("UserBoosterAccess")
  boosterQualifications BoosterQualification[] @relation("UserBoosterQualification")
  ledRuns        Run[]           @relation("RunRaidLead")
  signups        RunSignup[]
  approvedAccess   BoosterAccess[] @relation("BoosterAccessApprover")
  reviewedAccess   BoosterAccess[] @relation("BoosterAccessReviewer")
  grantedQualifications BoosterQualification[] @relation("BoosterQualificationGranter")
  revokedQualifications BoosterQualification[] @relation("BoosterQualificationRevoker")
  activity         ActivityEvent[]
  publishedRosters RunRoster[]     @relation("RosterPublisher")
  markedAttendance RunAttendance[] @relation("AttendanceMarker")
  preparedSettlements  RunSettlement[] @relation("SettlementPreparer")
  finalizedSettlements RunSettlement[] @relation("SettlementFinalizer")
  paidSettlements      RunSettlement[] @relation("SettlementPayer")
  payoutEntries        RunPayoutEntry[] @relation("PayoutRecipient")
  strikes              Strike[]        @relation("StrikeSubject")
  createdStrikes       Strike[]        @relation("StrikeCreator")
  revokedStrikes       Strike[]        @relation("StrikeRevoker")
  battleNetConnections BattleNetConnection[]
  battleNetImportSessions BattleNetImportSession[]

  @@map("user")
}

/// Optional Battle.net link per BoostingHub user + region.
/// Discord remains login. User OAuth tokens are never persisted here.
model BattleNetConnection {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  region             WowRegion
  battleNetAccountId String
  battleTag          String?
  scope              String?
  connectedAt        TimestamptzString
  lastSuccessfulSyncAt TimestamptzString?
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  @@unique([userId, region])
  @@index([userId])
  @@map("battle_net_connection")
}

/// Short-lived authoritative owned-character snapshot after OAuth.
/// Stores no OAuth tokens. Client selects by id against this snapshot only.
model BattleNetImportSession {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  region      WowRegion
  charactersJson String
  expiresAt   TimestamptzString
  consumedAt  TimestamptzString?
  createdAt   TimestamptzString @default(now())

  @@index([userId, region])
  @@index([expiresAt])
  @@map("battle_net_import_session")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt TimestamptzString
  token     String   @unique
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String   @id @default(uuid())
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  password              String?
  createdAt             TimestamptzString @default(now())
  updatedAt             temporal.updatedAtString()

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  TimestamptzString @default(now())
  updatedAt  temporal.updatedAtString()

  @@map("verification")
}

/// Owned WoW character. Display name/realm stay as entered; normalizedName /
/// normalizedRealm plus region form the owner-scoped unique identity.
/// Class is immutable after create until Blizzard sync can correct it.
/// Deactivate instead of delete so historical signups and lockouts survive.
model Character {
  id                   String        @id @default(uuid())
  userId               String
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                 String
  realm                String
  region               WowRegion
  normalizedName       String
  normalizedRealm      String
  wowClass             WowClass
  specialization       String?
  primaryRole          CharacterRole
  /// Blizzard-authoritative equipped item level. Null when Blizzard has not
  /// supplied one yet (never a 0 sentinel; never a manual User override).
  itemLevel            Int?
  isActive             Boolean       @default(true)
  /// Scoped Blizzard identity is region + blizzardRealmId + blizzardCharacterId.
  /// Not a global GUID; may change on realm transfer.
  blizzardCharacterId  String?
  blizzardRealmId      String?
  warcraftLogsId       String?
  lastSyncedAt         TimestamptzString?
  createdAt            TimestamptzString @default(now())
  updatedAt            temporal.updatedAtString()

  lockouts      CharacterRaidLockout[]
  signups       RunSignup[]
  boosterAccess BoosterAccess[]
  payoutEntries RunPayoutEntry[]

  @@unique([userId, region, normalizedRealm, normalizedName])
  /// One scoped Blizzard character may link to at most one BoostingHub row.
  /// Multiple NULLs remain allowed for manual Characters.
  @@unique([region, blizzardRealmId, blizzardCharacterId])
  @@index([userId])
  @@map("character")
}

/// LEGACY historical booster application/history.
/// Preserves User + Class + Role + Difficulty (+ optional Character context).
/// NOT the authoritative current eligibility source — see BoosterQualification.
model BoosterAccess {
  id           String              @id @default(uuid())
  userId       String
  user         User                @relation("UserBoosterAccess", fields: [userId], references: [id], onDelete: Cascade)
  characterId  String?
  character    Character?          @relation(fields: [characterId], references: [id], onDelete: SetNull)
  wowClass     WowClass
  role         CharacterRole
  difficulty   RaidDifficulty
  status       BoosterAccessStatus
  approvedAt   TimestamptzString?
  approvedById String?
  approvedBy   User?               @relation("BoosterAccessApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  reviewedAt   TimestamptzString?
  reviewedById String?
  reviewedBy   User?               @relation("BoosterAccessReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([userId, wowClass, role, difficulty])
  @@index([userId])
  @@index([status])
  @@map("booster_access")
}

/// Authoritative current Booster eligibility: User + Difficulty only.
/// Exact-match: MYTHIC does not imply HEROIC or NORMAL. One row per pair.
model BoosterQualification {
  id           String                       @id @default(uuid())
  userId       String
  user         User                         @relation("UserBoosterQualification", fields: [userId], references: [id], onDelete: Cascade)
  difficulty   RaidDifficulty
  status       BoosterQualificationStatus
  grantedAt    TimestamptzString?
  grantedById  String?
  grantedBy    User?                        @relation("BoosterQualificationGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedAt    TimestamptzString?
  revokedById  String?
  revokedBy    User?                        @relation("BoosterQualificationRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  notes        String?
  createdAt    TimestamptzString @default(now())
  updatedAt    temporal.updatedAtString()

  @@unique([userId, difficulty])
  @@index([userId])
  @@index([status])
  @@index([difficulty])
  @@map("booster_qualification")
}

model Raid {
  id        String   @id @default(uuid())
  name      String
  season    String
  isActive  Boolean  @default(true)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  bosses   RaidBoss[]
  lockouts CharacterRaidLockout[]
  runs     Run[]

  @@map("raid")
}

model RaidBoss {
  id        String @id @default(uuid())
  raidId    String
  raid      Raid   @relation(fields: [raidId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int

  @@index([raidId])
  @@map("raid_boss")
}

/// Lockouts are scoped to character + raid + difficulty + weekly reset.
/// They are never stored as a boolean on the character itself.
model CharacterRaidLockout {
  id               String         @id @default(uuid())
  characterId      String
  character        Character      @relation(fields: [characterId], references: [id], onDelete: Cascade)
  raidId           String
  raid             Raid           @relation(fields: [raidId], references: [id], onDelete: Cascade)
  difficulty       RaidDifficulty
  resetIdentifier  String
  bossesDefeated   Int            @default(0)
  isComplete       Boolean        @default(false)
  createdAt        TimestamptzString @default(now())
  updatedAt        temporal.updatedAtString()

  @@unique([characterId, raidId, difficulty, resetIdentifier])
  @@index([characterId])
  @@map("character_raid_lockout")
}

model Run {
  id                 String         @id @default(uuid())
  /// Server-derived (buildRunTitle) from scheduledStartAt/difficulty/lootType/
  /// plannedBossCount/raidLead — never a free-form User-authored value.
  title              String
  raidId             String
  raid               Raid           @relation(fields: [raidId], references: [id], onDelete: Restrict)
  difficulty         RaidDifficulty
  /// Independent of difficulty; MYTHIC+SAVED is rejected at the Service layer.
  lootType           RunLootType
  scheduledStartAt   TimestamptzString
  status             RunStatus
  raidLeadId         String
  raidLead           User           @relation("RunRaidLead", fields: [raidLeadId], references: [id], onDelete: Restrict)
  notes              String?
  desiredTankCount   Int
  desiredHealerCount Int
  desiredDpsCount    Int
  /// 1 <= plannedBossCount <= this Run's Raid's total boss count (RaidBoss row count).
  plannedBossCount   Int
  signupsOpen        Boolean        @default(false)
  archivedAt         TimestamptzString?
  archivedById       String?
  archivedBy         User?          @relation("RunArchivedBy", fields: [archivedById], references: [id], onDelete: SetNull)
  createdAt          TimestamptzString @default(now())
  updatedAt          temporal.updatedAtString()

  signups     RunSignup[]
  roster      RunRoster?
  attendance  RunAttendance[]
  settlement  RunSettlement?
  strikes     Strike[]
  discordPost RunDiscordPost?

  @@index([scheduledStartAt])
  @@index([status])
  @@index([archivedAt])
  @@map("run")
}

/// A user may offer more than one character for the same run.
/// Duplicate prevention is per run + user + character + participation type.
/// Withdrawn rows still occupy that unique key; a later signup of the same
/// combination revives the row instead of inserting a second record.
model RunSignup {
  id                    String                 @id @default(uuid())
  runId                 String
  run                   Run                    @relation(fields: [runId], references: [id], onDelete: Cascade)
  userId                String
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  characterId           String?
  character             Character?             @relation(fields: [characterId], references: [id], onDelete: SetNull)
  participationType     ParticipationType
  role                  CharacterRole?
  isBackup              Boolean                @default(false)
  status                SignupStatus
  lootbuddyMode         LootbuddyMode?
  lootbuddyVerification LootbuddyVerification?
  notes                 String?
  createdAt             TimestamptzString      @default(now())
  updatedAt             temporal.updatedAtString()

  rosterEntries RunRosterEntry[]
  payoutEntries RunPayoutEntry[]

  @@unique([runId, userId, characterId, participationType])
  @@index([userId])
  @@index([runId])
  @@map("run_signup")
}

/// One persisted roster per run. Draft selection lives in RunRosterEntry and is
/// independent of RunSignup.status until Publish copies the draft into SELECTED /
/// NOT_SELECTED. Editing after publish mutates the draft only; the live roster
/// stays on signup statuses until a replacement publish succeeds.
model RunRoster {
  id            String      @id @default(uuid())
  runId         String      @unique
  run           Run         @relation(fields: [runId], references: [id], onDelete: Cascade)
  state         RosterState @default(DRAFT)
  version       Int         @default(1)
  publishedAt   TimestamptzString?
  publishedById String?
  publishedBy   User?       @relation("RosterPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  entries RunRosterEntry[]

  @@map("run_roster")
}

model RunAttendance {
  id            String           @id @default(uuid())
  runId         String
  run           Run              @relation(fields: [runId], references: [id], onDelete: Cascade)
  rosterEntryId String           @unique
  rosterEntry   RunRosterEntry   @relation(fields: [rosterEntryId], references: [id], onDelete: Restrict)
  status        AttendanceStatus @default(UNMARKED)
  note          String?
  markedAt      TimestamptzString?
  markedById    String?
  markedBy      User?            @relation("AttendanceMarker", fields: [markedById], references: [id], onDelete: SetNull)
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  payoutEntry RunPayoutEntry?

  @@index([runId])
  @@index([status])
  @@map("run_attendance")
}

model RunRosterEntry {
  id        String     @id @default(uuid())
  rosterId  String
  roster    RunRoster  @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  signupId  String
  signup    RunSignup  @relation(fields: [signupId], references: [id], onDelete: Cascade)
  selected  Boolean    @default(true)
  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()

  attendance   RunAttendance?
  payoutEntries RunPayoutEntry[]

  @@unique([rosterId, signupId])
  @@index([rosterId])
  @@map("run_roster_entry")
}

/// One gold settlement per completed Run. Amounts are whole WoW gold integers.
/// Display snapshots are frozen at finalize; DRAFT may still refresh from live joins.
model RunSettlement {
  id            String           @id @default(uuid())
  runId         String           @unique
  run           Run              @relation(fields: [runId], references: [id], onDelete: Cascade)
  totalGold     Int
  status        SettlementStatus @default(DRAFT)
  preparedById  String
  preparedBy    User             @relation("SettlementPreparer", fields: [preparedById], references: [id], onDelete: Restrict)
  finalizedAt   TimestamptzString?
  finalizedById String?
  finalizedBy   User?            @relation("SettlementFinalizer", fields: [finalizedById], references: [id], onDelete: SetNull)
  paidAt        TimestamptzString?
  paidById      String?
  paidBy        User?            @relation("SettlementPayer", fields: [paidById], references: [id], onDelete: SetNull)
  runTitle      String
  raidName      String
  difficulty    RaidDifficulty
  raidLeadName  String
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  entries RunPayoutEntry[]

  @@index([status])
  @@map("run_settlement")
}

/// One attendance-derived payout line. Zero-share rows are kept for audit history.
model RunPayoutEntry {
  id                String            @id @default(uuid())
  settlementId      String
  settlement        RunSettlement     @relation(fields: [settlementId], references: [id], onDelete: Cascade)
  attendanceId      String            @unique
  attendance        RunAttendance     @relation(fields: [attendanceId], references: [id], onDelete: Restrict)
  rosterEntryId     String
  rosterEntry       RunRosterEntry    @relation(fields: [rosterEntryId], references: [id], onDelete: Restrict)
  signupId          String
  signup            RunSignup         @relation(fields: [signupId], references: [id], onDelete: Restrict)
  userId            String
  user              User              @relation("PayoutRecipient", fields: [userId], references: [id], onDelete: Restrict)
  characterId       String?
  character         Character?        @relation(fields: [characterId], references: [id], onDelete: SetNull)
  userDisplayName   String
  characterName     String
  characterRealm    String
  characterRegion   WowRegion?
  participationType ParticipationType
  attendanceStatus  AttendanceStatus
  role              CharacterRole?
  isBackup          Boolean
  shareUnits        Int
  amountGold        Int
  adjustmentReason  String?
  createdAt         TimestamptzString @default(now())
  updatedAt         temporal.updatedAtString()

  @@index([settlementId])
  @@index([userId])
  @@map("run_payout_entry")
}

model ActivityEvent {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  type        String
  message     String
  occurredAt  TimestamptzString @default(now())

  @@index([occurredAt])
  @@map("activity_event")
}

/// Disciplinary history record against a User. Creation is always an
/// explicit staff action — never automatic. Subject is always User (never
/// Character) so history survives role changes, Character deactivation, and
/// BoosterQualification changes. No hard delete; REVOKED is a staff
/// correction, not an expiry (there is no automatic expiry here).
///
/// Attendance and payout/financial-deduction handling are owned by the
/// external Dawn Boosting operational workflow, not BoostingHub — Strike
/// intentionally has no relation to RunAttendance or any financial record.
model Strike {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation("StrikeSubject", fields: [userId], references: [id], onDelete: Restrict)
  runId         String?
  run           Run?              @relation(fields: [runId], references: [id], onDelete: SetNull)
  reason        String
  notes         String?
  status        StrikeStatus      @default(ACTIVE)
  createdById   String
  createdBy     User              @relation("StrikeCreator", fields: [createdById], references: [id], onDelete: Restrict)
  revokedAt     TimestamptzString?
  revokedById   String?
  revokedBy     User?             @relation("StrikeRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  revokedReason String?
  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()

  @@index([userId])
  @@index([runId])
  @@map("strike")
}

/// Discord message identity for one Run's public posts. Presentation-only
/// integration state — never authoritative Run/Signup/Roster data, which the
/// Discord bot always re-derives from BoostingHub via the Bot API. Exists so
/// the bot can edit its own prior post instead of spamming a new message on
/// every sync pass, and survives a bot restart.
model RunDiscordPost {
  id                  String   @id @default(uuid())
  runId               String   @unique
  run                 Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// The Run's dedicated Discord text channel, when per-Run channel
  /// provisioning is enabled (bot-side DISCORD_RUN_CATEGORY_ID configured).
  /// Recorded as soon as the channel is created — independent of whether a
  /// signup message has been posted into it yet — so a crash between
  /// creation and posting never creates a second channel on retry. Identity
  /// is this id, never the generated name (names may be renamed later).
  runChannelId        String?
  signupChannelId     String?
  signupMessageId     String?
  signupPostedAt      TimestamptzString?
  /// Cheap fingerprint (e.g. unique signup count + window state) to detect
  /// whether the posted signup embed is stale without re-rendering it.
  lastSignupSignature String?
  rosterChannelId     String?
  rosterMessageId     String?
  rosterPostedAt      TimestamptzString?
  /// RunRoster.version at last successful roster post, to detect republish.
  lastRosterVersion   Int?
  createdAt           TimestamptzString @default(now())
  updatedAt           temporal.updatedAtString()

  @@map("run_discord_post")
}
